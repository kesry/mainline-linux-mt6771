

# vendor 下这几个文件是打包必需，允许入库
!vendor/stock-boot-orig.img
!vendor/a3-empty.cpio.gz
!vendor/*.dtb
!vendor/*.bin

# Python 缓存
__pycache__/
*.pyc
fnnas/ld-hooks/*.so

# fnnas 内核模块编译产物
fnnas/kmod/*.ko
fnnas/kmod/*.o
fnnas/kmod/*.mod
fnnas/kmod/*.mod.c
fnnas/kmod/*.mod.o
fnnas/kmod/Module.symvers
fnnas/kmod/modules.order

# kmod 编译中间文件
fnnas/kmod/.*.cmd
fnnas/kmod/..module-common.o.cmd
