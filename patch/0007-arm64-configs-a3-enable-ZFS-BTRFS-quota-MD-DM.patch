From: a3-port <a3@localhost>
Subject: [PATCH] arm64: configs: a3: enable ZFS/BTRFS/quota/MD-DM needed by fnOS

--- a/arch/arm64/configs/a3_defconfig	2026-11-21 16:25:11.103155827 +0800
+++ b/arch/arm64/configs/a3_defconfig	2026-11-21 16:25:11.106262224 +0800
@@ -176,6 +176,18 @@
 CONFIG_SRAM=y
 CONFIG_UACCE=m
 CONFIG_RAID_ATTRS=m
+CONFIG_SCSI=y
+CONFIG_BLK_DEV_SD=y
+CONFIG_CHR_DEV_SG=y
+CONFIG_MD=y
+CONFIG_MD_LINEAR=m
+CONFIG_BLK_DEV_DM=y
+CONFIG_DM_CRYPT=y
+CONFIG_DM_SNAPSHOT=y
+CONFIG_DM_THIN_PROVISIONING=y
+CONFIG_DM_MIRROR=y
+CONFIG_DM_RAID=y
+CONFIG_TARGET_CORE=y
 CONFIG_NETDEVICES=y
 CONFIG_MACVLAN=y
 CONFIG_IPVLAN=y
@@ -820,12 +832,17 @@
 CONFIG_HTE=y
 CONFIG_HTE_TEGRA194=y
 CONFIG_HTE_TEGRA194_TEST=m
+CONFIG_ZFS=y
 CONFIG_EXT4_FS=y
 CONFIG_EXT4_FS_POSIX_ACL=y
 CONFIG_EXT4_FS_SECURITY=y
+CONFIG_BTRFS_FS=y
+CONFIG_BTRFS_FS_POSIX_ACL=y
 CONFIG_FANOTIFY=y
 CONFIG_FANOTIFY_ACCESS_PERMISSIONS=y
 CONFIG_QUOTA=y
+CONFIG_QFMT_V1=y
+CONFIG_QFMT_V2=y
 CONFIG_AUTOFS_FS=y
 CONFIG_FUSE_FS=y
 CONFIG_CUSE=m
@@ -861,9 +878,7 @@
 CONFIG_CRYPTO_ECDH=m
 CONFIG_CRYPTO_CURVE25519=m
 CONFIG_CRYPTO_ECHAINIV=y
-CONFIG_CRYPTO_BLAKE2B=m
 CONFIG_CRYPTO_MICHAEL_MIC=m
-CONFIG_CRYPTO_XXHASH=m
 CONFIG_CRYPTO_DEFLATE=m
 CONFIG_CRYPTO_LZO=y
 CONFIG_CRYPTO_ZSTD=m
