diff --git a/drivers/gpu/drm/panel/panel-a3-nt36672.c b/drivers/gpu/drm/panel/panel-a3-nt36672.c
new file mode 100644
index 000000000..9ccdda757
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-a3-nt36672.c
@@ -0,0 +1,282 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * JDI nt36672 1080x2280 DSI video-mode panel as used on the OPPO A3 (P7771).
+ *
+ * The panel is a TDDI part: display and touch share one die, so this driver is
+ * also what has to power the touch block up.  The command sequence below is
+ * ported verbatim from the vendor LCM driver
+ *   drivers/misc/mediatek/lcm/oppo_dpt_jdi_nt36672_1080p_dsi_vdo
+ * which is the only authoritative description of this panel's init.
+ *
+ * Timings, same source:
+ *   VSA=2 VBP=10 VFP=25 VACT=2280 / HSA=2 HBP=30 HFP=40 HACT=1080
+ *   4 lanes, BURST_VDO, RGB888, 1029 Mbps/lane
+ * mtk_dsi derives the per-lane rate as pixelclock * bpp / lanes, so the pixel
+ * clock is 171.5 MHz.
+ */
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <video/mipi_display.h>
+#include <video/videomode.h>
+
+#define A3_PANEL_WIDTH   1080
+#define A3_PANEL_HEIGHT  2280
+#define A3_PANEL_CLOCK   171500000
+#define A3_PANEL_LANES   4
+
+struct a3_seq {
+	u8 cmd;
+	u8 len;
+	u8 data[4];
+	u16 delay_ms;		/* delay after this command */
+};
+
+
+/*
+ * Replayed in order from a3_panel_prepare().  A3_SEQ_DELAY entries only sleep,
+ * which is how the vendor table expresses the mandatory waits around sleep-out
+ * and display-on.
+ */
+static const struct a3_seq a3_init_seq[] = {
+	{ .cmd = 0xff, .len = 1, .data = { 0x23 } },
+	{ .cmd = 0xfb, .len = 1, .data = { 0x01 } },
+	{ .cmd = 0x11, .len = 1, .data = { 0x01 } },
+	{ .cmd = 0x12, .len = 1, .data = { 0x7e } },
+	{ .cmd = 0x15, .len = 1, .data = { 0x6e } },
+	{ .cmd = 0x16, .len = 1, .data = { 0x0b } },
+	{ .cmd = 0x45, .len = 1, .data = { 0xf6 } },
+	{ .cmd = 0x46, .len = 1, .data = { 0xf3 } },
+	{ .cmd = 0x47, .len = 1, .data = { 0xf0 } },
+	{ .cmd = 0x48, .len = 1, .data = { 0xed } },
+	{ .cmd = 0x49, .len = 1, .data = { 0xea } },
+	{ .cmd = 0x4a, .len = 1, .data = { 0xe7 } },
+	{ .cmd = 0x4b, .len = 1, .data = { 0xe4 } },
+	{ .cmd = 0x4c, .len = 1, .data = { 0xe1 } },
+	{ .cmd = 0x4d, .len = 1, .data = { 0xde } },
+	{ .cmd = 0x4e, .len = 1, .data = { 0xdb } },
+	{ .cmd = 0x4f, .len = 1, .data = { 0xd8 } },
+	{ .cmd = 0x50, .len = 1, .data = { 0xd5 } },
+	{ .cmd = 0x51, .len = 1, .data = { 0xd2 } },
+	{ .cmd = 0x52, .len = 1, .data = { 0xcf } },
+	{ .cmd = 0x53, .len = 1, .data = { 0xcc } },
+	{ .cmd = 0x54, .len = 1, .data = { 0xc9 } },
+	{ .cmd = 0x6f, .len = 1, .data = { 0x00 } },
+	{ .cmd = 0x70, .len = 1, .data = { 0x44 } },
+	{ .cmd = 0x71, .len = 1, .data = { 0x9a } },
+	{ .cmd = 0x05, .len = 1, .data = { 0x24 } },
+	{ .cmd = 0x07, .len = 1, .data = { 0x20 } },
+	{ .cmd = 0x08, .len = 1, .data = { 0x04 } },
+	{ .cmd = 0x09, .len = 1, .data = { 0x00 } },
+	{ .cmd = 0xff, .len = 1, .data = { 0x20 } },
+	{ .cmd = 0xfb, .len = 1, .data = { 0x01 } },
+	{ .cmd = 0x62, .len = 1, .data = { 0xba } },
+	{ .cmd = 0xff, .len = 1, .data = { 0x10 } },
+	{ .cmd = 0xfb, .len = 1, .data = { 0x01 } },
+	{ .cmd = 0x11, .len = 0, .data = {  } },
+	{ .len = 0xff, .delay_ms = 130 },
+	{ .cmd = 0x51, .len = 1, .data = { 0xff } },
+	{ .cmd = 0x53, .len = 1, .data = { 0x2c } },
+	{ .cmd = 0x55, .len = 1, .data = { 0x02 } },
+	{ .cmd = 0x35, .len = 1, .data = { 0x00 } },
+	{ .cmd = 0x29, .len = 0, .data = {  } },
+	{ .len = 0xff, .delay_ms = 20 },
+};
+
+struct a3_panel {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+};
+
+static inline struct a3_panel *to_a3_panel(struct drm_panel *panel)
+{
+	return container_of(panel, struct a3_panel, panel);
+}
+
+static int a3_panel_prepare(struct drm_panel *panel)
+{
+	/*
+	 * Deliberately empty: drm_atomic_bridge_chain_pre_enable() walks the chain
+	 * backwards, so this runs *before* mtk_dsi_poweron().  Sending DCS
+	 * commands here times out with -ETIME because the command channel is not
+	 * up yet; the init sequence therefore lives in a3_panel_enable().
+	 */
+	return 0;
+}
+
+/*
+ * Bring-up switch: with skip_init=1 the driver sends no DCS commands at all
+ * and leaves the panel exactly as the bootloader left it.  That isolates
+ * whether our init sequence is what takes the touch core down (the panel is a
+ * TDDI part, so a display reset also drops the touch firmware).
+ */
+static bool a3_skip_init;
+module_param(a3_skip_init, bool, 0644);
+MODULE_PARM_DESC(a3_skip_init, "1 = do not send the panel init sequence");
+
+static int a3_panel_enable(struct drm_panel *panel)
+{
+	struct a3_panel *ctx = to_a3_panel(panel);
+	struct mipi_dsi_device *dsi = ctx->dsi;
+	u8 buf[5];
+	int i, ret;
+
+	if (a3_skip_init) {
+		dev_info(&dsi->dev, "skip_init: leaving panel untouched");
+		return 0;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(a3_init_seq); i++) {
+		const struct a3_seq *s = &a3_init_seq[i];
+
+		if (s->len == 0xff) {
+			msleep(s->delay_ms);
+			continue;
+		}
+
+		buf[0] = s->cmd;
+		memcpy(&buf[1], s->data, s->len);
+		ret = mipi_dsi_dcs_write_buffer(dsi, buf, s->len + 1);
+		if (ret < 0) {
+			dev_err(&dsi->dev, "init cmd 0x%02x failed: %d\n",
+				s->cmd, ret);
+			return ret;
+		}
+	}
+
+	dev_info(&dsi->dev, "panel init sequence sent (%zu entries)\n",
+		 ARRAY_SIZE(a3_init_seq));
+	return 0;
+}
+
+static int a3_panel_disable(struct drm_panel *panel)
+{
+	struct a3_panel *ctx = to_a3_panel(panel);
+
+	mipi_dsi_dcs_write_seq(ctx->dsi, MIPI_DCS_SET_DISPLAY_OFF);
+	msleep(20);
+	mipi_dsi_dcs_write_seq(ctx->dsi, MIPI_DCS_ENTER_SLEEP_MODE);
+	msleep(120);
+	return 0;
+}
+
+static int a3_panel_unprepare(struct drm_panel *panel)
+{
+	return 0;
+}
+
+static int a3_panel_get_modes(struct drm_panel *panel,
+			      struct drm_connector *connector)
+{
+	struct drm_display_mode *mode;
+	struct videomode vm = {
+		.pixelclock = A3_PANEL_CLOCK,
+		.hactive = A3_PANEL_WIDTH,
+		.hfront_porch = 40,
+		.hback_porch = 30,
+		.hsync_len = 2,
+		.vactive = A3_PANEL_HEIGHT,
+		.vfront_porch = 25,
+		.vback_porch = 10,
+		.vsync_len = 2,
+	};
+
+	mode = drm_mode_create(connector->dev);
+	if (!mode) {
+		dev_err(panel->dev, "drm_mode_create failed\n");
+		return 0;
+	}
+	drm_display_mode_from_videomode(&vm, mode);
+	mode->type = DRM_MODE_TYPE_DRIVER | DRM_MODE_TYPE_PREFERRED;
+	drm_mode_set_name(mode);
+	drm_mode_probed_add(connector, mode);
+
+	dev_info(panel->dev, "added mode %s %ux%u clock=%u\n", mode->name,
+		 mode->hdisplay, mode->vdisplay, mode->clock);
+
+	connector->display_info.width_mm = 68;
+	connector->display_info.height_mm = 143;
+	connector->display_info.bpc = 8;
+
+	return 1;
+}
+
+static const struct drm_panel_funcs a3_panel_funcs = {
+	.prepare = a3_panel_prepare,
+	.enable = a3_panel_enable,
+	.disable = a3_panel_disable,
+	.unprepare = a3_panel_unprepare,
+	.get_modes = a3_panel_get_modes,
+};
+
+static int a3_panel_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct a3_panel *ctx;
+	int ret;
+
+	ctx = devm_kzalloc(dev, sizeof(*ctx), GFP_KERNEL);
+	if (!ctx)
+		return -ENOMEM;
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = A3_PANEL_LANES;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
+			  MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_NO_EOT_PACKET;
+
+	drm_panel_init(&ctx->panel, dev, &a3_panel_funcs,
+		       DRM_MODE_CONNECTOR_DSI);
+
+	ret = drm_panel_of_backlight(&ctx->panel);
+	if (ret)
+		dev_info(dev, "no backlight, continuing\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* this is what makes mtk_dsi register its DRM component */
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	dev_info(dev, "nt36672 1080x2280 panel attached (4 lanes, video burst)\n");
+	return 0;
+}
+
+static void a3_panel_remove(struct mipi_dsi_device *dsi)
+{
+	struct a3_panel *ctx = mipi_dsi_get_drvdata(dsi);
+
+	mipi_dsi_detach(dsi);
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id a3_panel_of_match[] = {
+	{ .compatible = "oppo,a3-nt36672" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a3_panel_of_match);
+
+static struct mipi_dsi_driver a3_panel_driver = {
+	.probe = a3_panel_probe,
+	.remove = a3_panel_remove,
+	.driver = {
+		.name = "panel-a3-nt36672",
+		.of_match_table = a3_panel_of_match,
+	},
+};
+module_mipi_dsi_driver(a3_panel_driver);
+
+MODULE_DESCRIPTION("JDI nt36672 DSI panel for the OPPO A3");
+MODULE_LICENSE("GPL");
