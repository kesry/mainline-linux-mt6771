diff --git a/drivers/net/wireless/mediatek/a3-consys.c b/drivers/net/wireless/mediatek/a3-consys.c
new file mode 100644
index 000000000..304443136
--- /dev/null
+++ b/drivers/net/wireless/mediatek/a3-consys.c
@@ -0,0 +1,127 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OPPO A3 (MT6771) CONSYS (MT6631 combo) bring-up driver.
+ *
+ * This is a *diagnostic* platform driver, not the real wlan driver: it claims
+ * the vendor "mediatek,mt6771-consys" node so that the chip resources are
+ * properly owned, maps the register windows, and reports whether the
+ * subsystem answers on the bus after a3-consys-power (CONFIG_A3_CONSYS_PWR)
+ * has raised the CONN domain and ungated its clocks.
+ *
+ * Structure follows drivers/net/wireless/mediatek/mt76/mt7603/soc.c
+ * (probe -> ioremap -> read chip id -> request irq), which is the layout the
+ * eventual gen4m/mt76-based driver will use.
+ *
+ * Register windows, from the vendor DTB (consys@18070000):
+ *   0: 0x18070000 + 0x1000  consys  (AP side control)
+ *   1: 0x10007000 + 0x100   connac top? (APBASE2)
+ *   2: 0x10001000 + 0x1000  infracfg (bus protect etc.)
+ *   3: 0x10006000 + 0x1000  SPM (power domain control)
+ * IRQs: 289 (conn2ap), 291 (warm restart?).
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/io.h>
+#include <linux/interrupt.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <linux/of_address.h>
+
+struct a3_consys {
+	struct device *dev;
+	void __iomem *base;
+	void __iomem *connac;
+	int irq_conn;
+};
+
+static irqreturn_t a3_consys_irq(int irq, void *dev)
+{
+	struct a3_consys *cs = dev;
+
+	/* The conn2ap interrupt fires for chip-init / exception events; until
+	 * the real driver exists just report it so the host can see activity. */
+	dev_info_ratelimited(cs->dev, "consys irq %d\n", irq);
+	return IRQ_HANDLED;
+}
+
+static int a3_consys_probe(struct platform_device *pdev)
+{
+	struct a3_consys *cs;
+	struct device_node *np;
+	u32 v0, v4;
+	int ret;
+
+	cs = devm_kzalloc(&pdev->dev, sizeof(*cs), GFP_KERNEL);
+	if (!cs)
+		return -ENOMEM;
+
+	cs->dev = &pdev->dev;
+	cs->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(cs->base))
+		return PTR_ERR(cs->base);
+
+	cs->connac = devm_platform_ioremap_resource(pdev, 1);
+	if (IS_ERR(cs->connac))
+		cs->connac = NULL;
+
+	cs->irq_conn = platform_get_irq(pdev, 0);
+	if (cs->irq_conn < 0)
+		dev_warn(&pdev->dev, "no conn irq (%d)\n", cs->irq_conn);
+
+	/* Life signs: read two words. All-FF or all-00 with the power domain
+	 * and clocks up means the bus protect is still closed. */
+	v0 = readl(cs->base + 0x00);
+	v4 = readl(cs->base + 0x04);
+
+	dev_info(&pdev->dev, "consys mapped, [0x00]=0x%08x [0x04]=0x%08x\n",
+		 v0, v4);
+
+	/* Report the EMI window reserved for the chip (firmware load target).
+	 * The vendor stack picks it up through RESERVEDMEM_OF_DECLARE on
+	 * "mediatek,consys-reserve-memory" and hands gConEmiPhyBase to gen4m;
+	 * printing it here makes the memory layout visible in one boot. */
+	np = of_parse_phandle(pdev->dev.of_node, "memory-region", 0);
+	if (np) {
+		struct resource r;
+
+		if (!of_address_to_resource(np, 0, &r)) {
+			dev_info(&pdev->dev,
+				 "consys EMI window: 0x%pa size 0x%pa\n",
+				 &r.start, &r.end);
+		}
+		of_node_put(np);
+	} else {
+		dev_info(&pdev->dev, "no memory-region in the consys node\n");
+	}
+
+	if (cs->irq_conn >= 0) {
+		ret = devm_request_irq(&pdev->dev, cs->irq_conn, a3_consys_irq,
+				       0, "a3-consys", cs);
+		if (ret)
+			dev_warn(&pdev->dev, "irq request failed (%d)\n", ret);
+	}
+
+	platform_set_drvdata(pdev, cs);
+	dev_info(&pdev->dev, "A3 consys probe done (diagnostic only)\n");
+	return 0;
+}
+
+static const struct of_device_id a3_consys_of_match[] = {
+	{ .compatible = "mediatek,mt6771-consys" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a3_consys_of_match);
+
+static struct platform_driver a3_consys_driver = {
+	.probe = a3_consys_probe,
+	.driver = {
+		.name = "a3-consys",
+		.of_match_table = a3_consys_of_match,
+	},
+};
+module_platform_driver(a3_consys_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("OPPO A3 MT6771 CONSYS bring-up diagnostics");
diff --git a/drivers/net/wireless/mediatek/a3-wmac.c b/drivers/net/wireless/mediatek/a3-wmac.c
