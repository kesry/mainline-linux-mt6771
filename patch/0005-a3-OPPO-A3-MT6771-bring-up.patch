+static const u16 a3_pullsel_addr[A3_NPINS] = {0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x000,0x000,0x000,0x000,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x000,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080,0x080};
