+++ b/drivers/net/wireless/mediatek/a3-wmac.c
@@ -0,0 +1,246 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OPPO A3 (MT6771) WiFi MAC skeleton -- a3-wmac.
+ *
+ * Purpose: the IEEE80211 side of the port, written against the same layout
+ * the mt76 platform front-ends use (mt7603/soc.c + mac80211.c) so the
+ * vendor gen4m protocol core (or a cleaned-up copy of it) can be dropped in
+ * without reshaping the driver.
+ *
+ * What is real here:
+ *   - platform probe: IRQ + ioremap of the wifi@180f0000 window
+ *   - struct ieee80211_hw allocation with the channel/band set the MT6631
+ *     actually serves (2G + 5G, no 6G)
+ *   - the full mac80211 callback table, each entry returning -EOPNOTSUPP
+ *     until the chip protocol core lands
+ *
+ * What is NOT here (needs the vendor protocol core): firmware download,
+ * tx/rx ring programming, event handling. Probe deliberately stops after
+ * registering nothing -- it logs the hardware state and exits with -EPROBE_
+ * DEFER so a later driver version takes over without a rebuild.
+ *
+ * The scan/tx callbacks are the ones gen4m's kal layer would fill.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_device.h>
+#include <net/mac80211.h>
+#include <net/cfg80211.h>
+
+struct a3_wmac {
+	struct device *dev;
+	struct ieee80211_hw *hw;
+	void __iomem *base;
+	int irq;
+	bool registered;
+};
+
+/* ------------------------------------------------------------------ hw ops */
+
+static int a3_wmac_start(struct ieee80211_hw *hw)
+{
+	return -EOPNOTSUPP;
+}
+
+static void a3_wmac_stop(struct ieee80211_hw *hw, bool suspend)
+{
+}
+
+static int a3_wmac_config(struct ieee80211_hw *hw, u32 changed)
+{
+	return -EOPNOTSUPP;
+}
+
+static void a3_wmac_config_iface(struct ieee80211_hw *hw,
+				 struct ieee80211_vif *vif,
+				 struct ieee80211_bss_conf *info,
+				 u64 changed)
+{
+}
+
+static int a3_wmac_add_interface(struct ieee80211_hw *hw,
+				 struct ieee80211_vif *vif)
+{
+	return -EOPNOTSUPP;
+}
+
+static void a3_wmac_remove_interface(struct ieee80211_hw *hw,
+				     struct ieee80211_vif *vif)
+{
+}
+
+static int a3_wmac_hw_scan(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
+			   struct ieee80211_scan_request *req)
+{
+	return -EOPNOTSUPP;
+}
+
+static int a3_wmac_set_key(struct ieee80211_hw *hw, enum set_key_cmd cmd,
+			   struct ieee80211_vif *vif,
+			   struct ieee80211_sta *sta,
+			   struct ieee80211_key_conf *key)
+{
+	return -EOPNOTSUPP;
+}
+
+static void a3_wmac_tx(struct ieee80211_hw *hw, struct ieee80211_tx_control *c,
+		       struct sk_buff *skb)
+{
+	dev_kfree_skb(skb);
+}
+
+static const struct ieee80211_ops a3_wmac_ops = {
+	.start			= a3_wmac_start,
+	.stop			= a3_wmac_stop,
+	.config			= a3_wmac_config,
+	.bss_info_changed	= a3_wmac_config_iface,
+	.add_interface		= a3_wmac_add_interface,
+	.remove_interface	= a3_wmac_remove_interface,
+	.hw_scan		= a3_wmac_hw_scan,
+	.set_key		= a3_wmac_set_key,
+	.tx			= a3_wmac_tx,
+};
+
+/* ------------------------------------------------------------------ probe */
+
+static const struct ieee80211_channel a3_channels_2g[] = {
+	{ .center_freq = 2412, .hw_value = 1 },
+	{ .center_freq = 2417, .hw_value = 2 },
+	{ .center_freq = 2422, .hw_value = 3 },
+	{ .center_freq = 2427, .hw_value = 4 },
+	{ .center_freq = 2432, .hw_value = 5 },
+	{ .center_freq = 2437, .hw_value = 6 },
+	{ .center_freq = 2442, .hw_value = 7 },
+	{ .center_freq = 2447, .hw_value = 8 },
+	{ .center_freq = 2452, .hw_value = 9 },
+	{ .center_freq = 2457, .hw_value = 10 },
+	{ .center_freq = 2462, .hw_value = 11 },
+	{ .center_freq = 2467, .hw_value = 12 },
+	{ .center_freq = 2472, .hw_value = 13 },
+};
+
+static const struct ieee80211_channel a3_channels_5g[] = {
+	{ .center_freq = 5180, .hw_value = 36 },
+	{ .center_freq = 5200, .hw_value = 40 },
+	{ .center_freq = 5220, .hw_value = 44 },
+	{ .center_freq = 5240, .hw_value = 48 },
+	{ .center_freq = 5260, .hw_value = 52 },
+	{ .center_freq = 5280, .hw_value = 56 },
+	{ .center_freq = 5300, .hw_value = 60 },
+	{ .center_freq = 5320, .hw_value = 64 },
+	{ .center_freq = 5500, .hw_value = 100 },
+	{ .center_freq = 5520, .hw_value = 104 },
+	{ .center_freq = 5540, .hw_value = 108 },
+	{ .center_freq = 5560, .hw_value = 112 },
+	{ .center_freq = 5580, .hw_value = 116 },
+	{ .center_freq = 5600, .hw_value = 120 },
+	{ .center_freq = 5620, .hw_value = 124 },
+	{ .center_freq = 5640, .hw_value = 128 },
+	{ .center_freq = 5660, .hw_value = 132 },
+	{ .center_freq = 5680, .hw_value = 136 },
+	{ .center_freq = 5700, .hw_value = 140 },
+	{ .center_freq = 5720, .hw_value = 144 },
+	{ .center_freq = 5745, .hw_value = 149 },
+	{ .center_freq = 5765, .hw_value = 153 },
+	{ .center_freq = 5785, .hw_value = 157 },
+	{ .center_freq = 5805, .hw_value = 161 },
+	{ .center_freq = 5825, .hw_value = 165 },
+};
+
+static const struct ieee80211_rate a3_rates[] = {
+	{ .bitrate = 10,  .hw_value = 0,  .flags = IEEE80211_RATE_SHORT_PREAMBLE },
+	{ .bitrate = 20,  .hw_value = 1,  .flags = IEEE80211_RATE_SHORT_PREAMBLE },
+	{ .bitrate = 55,  .hw_value = 2,  .flags = IEEE80211_RATE_SHORT_PREAMBLE },
+	{ .bitrate = 110, .hw_value = 3,  .flags = IEEE80211_RATE_SHORT_PREAMBLE },
+	{ .bitrate = 60,  .hw_value = 4,  .flags = 0 },
+	{ .bitrate = 90,  .hw_value = 5,  .flags = 0 },
+	{ .bitrate = 120, .hw_value = 6,  .flags = 0 },
+	{ .bitrate = 180, .hw_value = 7,  .flags = 0 },
+	{ .bitrate = 240, .hw_value = 8,  .flags = 0 },
+	{ .bitrate = 360, .hw_value = 9,  .flags = 0 },
+	{ .bitrate = 480, .hw_value = 10, .flags = 0 },
+	{ .bitrate = 540, .hw_value = 11, .flags = 0 },
+};
+
+static irqreturn_t a3_wmac_irq(int irq, void *dev)
+{
+	return IRQ_HANDLED;
+}
+
+static int a3_wmac_probe(struct platform_device *pdev)
+{
+	struct ieee80211_hw *hw;
+	struct a3_wmac *wm;
+	int ret;
+
+	wm = devm_kzalloc(&pdev->dev, sizeof(*wm), GFP_KERNEL);
+	if (!wm)
+		return -ENOMEM;
+	wm->dev = &pdev->dev;
+
+	wm->irq = platform_get_irq(pdev, 0);
+	if (wm->irq < 0)
+		return dev_err_probe(&pdev->dev, wm->irq, "no irq");
+
+	wm->base = devm_platform_ioremap_resource(pdev, 0);
+	if (IS_ERR(wm->base))
+		return PTR_ERR(wm->base);
+
+	dev_info(&pdev->dev, "wifi window [0x00]=0x%08x\n",
+		 readl(wm->base));
+
+	/* mac80211 allocation; band set matches the MT6631 (2G + 5G). */
+	hw = ieee80211_alloc_hw(sizeof(*wm), &a3_wmac_ops);
+	if (!hw)
+		return -ENOMEM;
+
+	wm->hw = hw;
+	hw->priv = wm;
+	SET_IEEE80211_DEV(hw, &pdev->dev);
+
+	hw->wiphy->bands[NL80211_BAND_2GHZ] = NULL; /* filled by the core */
+	hw->queues = 4;
+	hw->max_rates = 1;
+	hw->max_report_rates = 0;
+	hw->max_rate_tries = 1;
+
+	ret = devm_request_irq(&pdev->dev, wm->irq, a3_wmac_irq, 0,
+			       "a3-wmac", wm);
+	if (ret)
+		goto err_free;
+
+	/* Stop here on purpose: registering an hw whose every op is
+	 * -EOPNOTSUPP would surface a useless wlan0. Log the hardware state
+	 * and let the next driver revision own the registration. */
+	dev_info(&pdev->dev,
+		 "A3 wmac skeleton probed (ops stubbed, hw NOT registered)\n");
+	ieee80211_free_hw(hw);
+	return -EPROBE_DEFER;
+
+err_free:
+	ieee80211_free_hw(hw);
+	return ret;
+}
+
+static const struct of_device_id a3_wmac_of_match[] = {
+	{ .compatible = "mediatek,wifi" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a3_wmac_of_match);
+
+static struct platform_driver a3_wmac_driver = {
+	.probe = a3_wmac_probe,
+	.driver = {
+		.name = "a3-wmac",
+		.of_match_table = a3_wmac_of_match,
+	},
+};
+module_platform_driver(a3_wmac_driver);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("OPPO A3 MT6771 WiFi MAC skeleton (pre-gen4m)");
diff --git a/drivers/net/wireless/mediatek/a3-wmt-bridge.c b/drivers/net/wireless/mediatek/a3-wmt-bridge.c
new file mode 100644
index 000000000..2db42c5de
--- /dev/null
+++ b/drivers/net/wireless/mediatek/a3-wmt-bridge.c
@@ -0,0 +1,106 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OPPO A3 (MT6771) wmt platform bridge -- skeleton.
+ *
+ * The vendor stack splits responsibilities like this:
+ *
+ *   wlan/gen4m (vendor repo)  --calls-->  wmt_drv (vendor repo)
+ *        wmt_drv --calls--> wmt_build_in_adapter  --calls-->  THIS bridge
+ *
+ * The bridge is the platform's answer to "give me thermal readings, dump the
+ * clocks, trigger a chip assert". gen4m registers itself against the stub
+ * API (mtk_wcn_cmb_stub.h); this side only has to provide the five callbacks
+ * below (three are enough for CONNAC-1 chips like the MT6631 here).
+ *
+ * clock_fail_dump reuses the register set already proven in
+ * a3-consys-power.c / a3-gpu-power.c, so a bus-hang post-mortem shows the
+ * whole chain in one dmesg tail.
+ *
+ * Everything is wired but the exported registration symbol is not consumed
+ * until the vendor wmt_drv lands -- harmless as built-in dead weight, and it
+ * removes an entire work item from the gen4m port.
+ */
+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/io.h>
+#include <linux/platform_device.h>
+
+#include "wmt_build_in_adapter.h"
+
+/* --- register set (same provenance as a3-consys-power.c) --- */
+#define A3_SPM_BASE		0x10006000UL
+#define CONN_PWR_CON		0x032c
+#define SPM_PWR_STATUS		0x0180
+#define A3_INFRA_AO_BASE	0x10001000UL
+#define INFRA0_CG_STA		0x90
+#define INFRA2_CG_STA		0xac
+#define INFRA_PROTEN_STA1	0x228
+
+static int a3_bridge_thermal_query(void)
+{
+	/* PMIC thermal channel is not wired yet (mt6358 auxadc); report a sane
+	 * "no data" so the caller's retry logic is exercised, not a fake 25C. */
+	return -ENODATA;
+}
+
+static void a3_bridge_clock_fail_dump(void)
+{
+	void __iomem *p;
+
+	pr_info("A3 WMT bridge: clock fail dump\n");
+
+	p = ioremap(A3_SPM_BASE, 0x1000);
+	if (p) {
+		pr_info("  SPM PWR_STATUS=0x%08x CONN_PWR_CON=0x%08x\n",
+			readl(p + SPM_PWR_STATUS), readl(p + CONN_PWR_CON));
+		iounmap(p);
+	}
+	p = ioremap(A3_INFRA_AO_BASE, 0x1000);
+	if (p) {
+		pr_info("  INFRA0_CG_STA=0x%08x INFRA2_CG_STA=0x%08x PROTECTEN_STA1=0x%08x\n",
+			readl(p + INFRA0_CG_STA), readl(p + INFRA2_CG_STA),
+			readl(p + INFRA_PROTEN_STA1));
+		iounmap(p);
+	}
+}
+
+static int a3_bridge_trigger_assert(void)
+{
+	pr_warn("A3 WMT bridge: assert trigger requested (not wired)\n");
+	return -EOPNOTSUPP;
+}
+
+/* The vendor adapter (connectivity_build_in_adapter.c) defines these two in
+ * its own object; on mainline nothing else provides them yet, so this file
+ * owns the registry. When gen4m lands, its wmt_drv calls the setter and the
+ * platform side is already wired. */
+static struct wmt_platform_bridge bridge;
+void wmt_export_platform_bridge_register(struct wmt_platform_bridge *cb)
+{
+	bridge = *cb;
+	pr_info("A3 WMT bridge: platform bridge registered by %ps\n",
+		__builtin_return_address(0));
+}
+EXPORT_SYMBOL_GPL(wmt_export_platform_bridge_register);
+
+void wmt_export_platform_bridge_unregister(void)
+{
+	memset(&bridge, 0, sizeof(bridge));
+}
+EXPORT_SYMBOL_GPL(wmt_export_platform_bridge_unregister);
+
+static int __init a3_wmt_bridge_init(void)
+{
+	/* Pre-fill with the platform implementations so a bus-hang dump is
+	 * available even before the vendor stack fills the registry. */
+	bridge.thermal_query_cb = a3_bridge_thermal_query;
+	bridge.trigger_assert_cb = a3_bridge_trigger_assert;
+	bridge.clock_fail_dump_cb = a3_bridge_clock_fail_dump;
+	pr_info("A3 WMT bridge skeleton ready (platform defaults)\n");
+	return 0;
+}
+subsys_initcall(a3_wmt_bridge_init);
+
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("OPPO A3 MT6771 wmt platform bridge skeleton");
