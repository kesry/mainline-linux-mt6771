diff --git a/arch/arm64/kernel/a3-consys-power.c b/arch/arm64/kernel/a3-consys-power.c
new file mode 100644
index 000000000..898ec2774
--- /dev/null
+++ b/arch/arm64/kernel/a3-consys-power.c
@@ -0,0 +1,409 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * TEMPORARY bring-up aid for the OPPO A3 (MT6771) CONSYS (MT6631 combo chip).
+ *
+ * Two parts:
+ *
+ *  1. At boot it runs exactly the sequence that is known to boot and to bring
+ *     the CONN domain up (SPM power-on first, then the two clock gates, then
+ *     the CONN/WiFi window reads). Deliberately identical to the v172 build,
+ *     which boots and prints a clean trace. Nothing risky runs at boot.
+ *
+ *  2. It exposes /proc/a3consys so the risky steps can be tried at runtime
+ *     from a shell instead of burning a flash cycle per hypothesis:
+ *
+ *       echo dump  > /proc/a3consys   # safe register set
+ *       echo mcu   > /proc/a3consys   # 0x18070000 / 0x180f0000 only
+ *       echo osc   > /proc/a3consys   # AP2CONN_OSC_EN wakeup (infracfg 0x1f00 BIT9)
+ *       echo emi   > /proc/a3consys   # EMI remap (infracfg 0x1380/0x1388)
+ *       echo spmon > /proc/a3consys   # re-run the whole power sequence
+ *       echo rgu   > /proc/a3consys   # read 0x10007000   (may stall the bus)
+ *       echo hifon > /proc/a3consys   # read 0x18007000   (may stall the bus)
+ *
+ *     A command that locks the interconnect freezes the device visibly; that
+ *     is the experiment's answer, and everything proven before it stays.
+ *
+ * Why this shape: the v173/v174 builds hung at the boot logo because they
+ * poked windows that are unclocked at that moment. Whatever the exact culprit
+ * (AP_RGU / CONN_HIF_ON reads, the EMI remap write, or the AP2CONN write),
+ * the lesson is the same - do the risky work on demand, from a live shell,
+ * after the kernel is already up.
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+#include <linux/proc_fs.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/platform_device.h>
+
+#define A3_SPM_BASE		0x10006000UL
+#define SPM_PWR_STATUS		0x0180
+#define SPM_PWR_STATUS_2ND	0x0184
+#define CONN_PWR_CON		0x032c
+#define CONN_STA_MASK		BIT(1)
+
+#define PWR_RST_B		BIT(0)
+#define PWR_ISO			BIT(1)
+#define PWR_ON			BIT(2)
+#define PWR_ON_2ND		BIT(3)
+#define PWR_CLK_DIS		BIT(4)
+
+#define A3_INFRA_AO_BASE	0x10001000UL
+#define A3_INFRA_AO_SIZE	0x2000
+#define INFRA_EMI_MAPPING	0x1380
+#define INFRA_EMI_PERI_MAPPING	0x1388
+#define INFRA0_CG_CLR		0x84
+#define INFRA0_CG_STA		0x90
+#define INFRA0_PMIC_CONN	BIT(3)
+#define INFRA2_CG_CLR		0xa8
+#define INFRA2_CG_STA		0xac
+#define INFRA2_AUDIO_26M_BCLK	BIT(4)
+#define INFRA_AP2CONN_OSC_EN	0x1f00
+#define AP2CONN_WAKEUP		BIT(9)
+#define INFRA_PROTEN_STA1	0x228
+/* A3: vendor clk-mt6763-pg.c / clk-mt6771-pg.c define these for CONN power-on */
+#define INFRA_TOPAXI_PROTECTEN_CLR	0x2A4	/* release AXI bus protect */
+#define INFRA_TOPAXI_PROTECTEN_SET	0x2A0
+#define INFRA2_CQ_DMA_CG		BIT(27)	/* INFRACFG_AO_CQ_DMA_CG=78, GATE_INFRA2 shift 27 */
+/* A3_BTIF_CLK: BTIF needs its bus clocks ungated before the driver can talk to
+ * the CONN MCU.  Vendor clk-mt6771.c:
+ *   GATE_INFRA0(INFRACFG_AO_BTIF_CG,  "infra_btif",  "axi_sel", 31)
+ *   GATE_INFRA1(INFRACFG_AO_AP_DMA_CG,"infra_apdma", "axi_sel", 18)
+ *   infra0_cg_regs = { set=0x80, clr=0x84, sta=0x90 }
+ *   infra1_cg_regs = { set=0x88, clr=0x8c, sta=0x94 }
+ */
+#define INFRA1_CG_CLR		0x8c
+#define INFRA1_CG_STA		0x94
+#define INFRA0_BTIF_CG		BIT(31)	/* infra_btif  */
+#define INFRA1_AP_DMA_CG	BIT(18)	/* infra_apdma */
+#define CONN_PROT_BIT_MASK		(BIT(13) | BIT(14))
+/* A3: exact vendor constants from mt6771-modules .../platform/include/mt6771.h */
+#define CONSYS_PWR_CONN_ACK_OFFSET	0x0180	/* spm_base + 0x180 */
+#define CONSYS_PWR_CONN_ACK_S_OFFSET	0x0184
+#define CONSYS_PWR_ON_ACK_BIT		BIT(1)
+#define CONSYS_PWR_ON_ACK_S_BIT		BIT(1)
+#define CONSYS_TOP2_PWR_ON_ACK_BIT	BIT(30)
+#define CONSYS_TOP2_PWR_ON_ACK_S_BIT	BIT(30)
+
+#define A3_CONSYS_BASE		0x18070000UL
+#define A3_WIFI_BASE		0x180f0000UL
+/* only on explicit request: unclocked windows that stall the interconnect */
+#define A3_RGU_BASE		0x10007000UL
+#define A3_HIF_ON_BASE		0x18007000UL
+
+/* map base+off and read it, printing the value; returns the value */
+static u32 a3_rd(unsigned long base, u32 off, const char *tag, u32 size)
+{
+	void __iomem *p = ioremap(base, size);
+	u32 v;
+
+	if (!p) {
+		pr_info("A3 CONSYS: %s iomap(%#lx) failed\n", tag, base);
+		return 0xffffffff;
+	}
+	v = readl(p + off);
+	pr_info("A3 CONSYS: %s %#lx+%#x = 0x%08x\n", tag, base, off, v);
+	iounmap(p);
+	return v;
+}
+
+/* ---- boot-time sequence: the combination known to boot --------------- */
+static void a3_boot_sequence(void)
+{
+	void __iomem *p, *q;
+	u32 val, i;
+	int on = 0;
+
+	p = ioremap(A3_SPM_BASE, 0x1000);
+	if (!p) {
+		pr_warn("A3 CONSYS: cannot ioremap SPM\n");
+		return;
+	}
+	val = readl(p + CONN_PWR_CON);
+	pr_info("A3 CONSYS: CONN_PWR_CON = 0x%08x\n", val);
+	if (!(val & PWR_ON)) {
+		writel(val | PWR_ON, p + CONN_PWR_CON);
+		writel(readl(p + CONN_PWR_CON) | PWR_ON_2ND, p + CONN_PWR_CON);
+	}
+	/* vendor: poll CONSYS_PWR_ON_ACK_BIT on 0x180 and 0x184 */
+	for (i = 0; i < 2000; i++) {
+		u32 a1 = readl(p + CONSYS_PWR_CONN_ACK_OFFSET) & CONSYS_PWR_ON_ACK_BIT;
+		u32 a2 = readl(p + CONSYS_PWR_CONN_ACK_S_OFFSET) & CONSYS_PWR_ON_ACK_S_BIT;
+
+		if (a1 && a2) {
+			on = 1;
+			break;
+		}
+		udelay(10);
+	}
+	pr_info("A3 CONSYS: PWR_ACK %s (ack=0x%08x ack_s=0x%08x)\n",
+		on ? "ok" : "TIMEOUT",
+		readl(p + CONSYS_PWR_CONN_ACK_OFFSET),
+		readl(p + CONSYS_PWR_CONN_ACK_S_OFFSET));
+	val = readl(p + CONN_PWR_CON);
+	val &= ~PWR_CLK_DIS;
+	writel(val, p + CONN_PWR_CON);
+	udelay(1);
+	val &= ~PWR_ISO;
+	writel(val, p + CONN_PWR_CON);
+	val |= PWR_RST_B;
+	writel(val, p + CONN_PWR_CON);
+	pr_info("A3 CONSYS: CONN_PWR_CON now 0x%08x\n", readl(p + CONN_PWR_CON));
+	iounmap(p);
+
+	p = ioremap(A3_INFRA_AO_BASE, A3_INFRA_AO_SIZE);
+	if (p) {
+		pr_info("A3 CONSYS: INFRA0_CG_STA 0x%08x\n", readl(p + INFRA0_CG_STA));
+		writel(INFRA0_PMIC_CONN, p + INFRA0_CG_CLR);
+		pr_info("A3 CONSYS: INFRA0_CG_STA now 0x%08x\n", readl(p + INFRA0_CG_STA));
+		pr_info("A3 CONSYS: INFRA2_CG_STA 0x%08x\n", readl(p + INFRA2_CG_STA));
+		writel(INFRA2_AUDIO_26M_BCLK, p + INFRA2_CG_CLR);
+		writel(INFRA2_CQ_DMA_CG, p + INFRA2_CG_CLR);
+		/* A3_BTIF_CLK: ungated here because mainline has no mt6771 clk driver,
+		 * so devm_clk_get("btifc"/"apdmac") fails inside the BTIF driver.
+		 */
+		writel(INFRA0_BTIF_CG, p + INFRA0_CG_CLR);
+		writel(INFRA1_AP_DMA_CG, p + INFRA1_CG_CLR);
+		pr_info("A3 CONSYS: btifc=%d apdmac=%d (STA0=0x%08x STA1=0x%08x)\n",
+			(readl(p + INFRA0_CG_STA) & INFRA0_BTIF_CG) ? 0 : 1,
+			(readl(p + INFRA1_CG_STA) & INFRA1_AP_DMA_CG) ? 0 : 1,
+			readl(p + INFRA0_CG_STA), readl(p + INFRA1_CG_STA));
+		pr_info("A3 CONSYS: INFRA2_CG_STA now 0x%08x (cqdma ungated=%d)\n",
+			readl(p + INFRA2_CG_STA),
+			(readl(p + INFRA2_CG_STA) & INFRA2_CQ_DMA_CG) ? 0 : 1);
+		pr_info("A3 CONSYS: PROTECTEN_STA1 0x%08x\n", readl(p + INFRA_PROTEN_STA1));
+		/* A3: vendor spm_mtcmos_ctrl_conn() releases AXI bus protect last.
+		 * Without this the CONN AXI slave stays protected and any access
+		 * to the WIFI-HIF / DMA windows returns the AXI default 0x43.
+		 */
+		writel(CONN_PROT_BIT_MASK, p + INFRA_TOPAXI_PROTECTEN_CLR);
+		pr_info("A3 CONSYS: PROTECTEN_STA1 after CLR 0x%08x\n",
+			readl(p + INFRA_PROTEN_STA1));
+		iounmap(p);
+
+		/* A3: vendor waits for conn_top2 ack (bit30) only AFTER releasing
+		 * the AXI protect.  Skipping this leaves the WiFi top2 domain
+		 * un-powered, so the HIF/PDMA block never gets its clock and any
+		 * write to it is dropped while reads return the AXI default.
+		 */
+		q = ioremap(A3_SPM_BASE, 0x1000);
+		if (q) {
+			u32 t2 = 0, t2s = 0;
+
+			for (i = 0; i < 2000; i++) {
+				t2 = readl(q + CONSYS_PWR_CONN_ACK_OFFSET) &
+				     CONSYS_TOP2_PWR_ON_ACK_BIT;
+				t2s = readl(q + CONSYS_PWR_CONN_ACK_S_OFFSET) &
+				      CONSYS_TOP2_PWR_ON_ACK_S_BIT;
+				if (t2 && t2s)
+					break;
+				udelay(10);
+			}
+			pr_info("A3 CONSYS: TOP2_ACK %s (ack=0x%08x ack_s=0x%08x)\n",
+				(t2 && t2s) ? "ok" : "TIMEOUT",
+				readl(q + CONSYS_PWR_CONN_ACK_OFFSET),
+				readl(q + CONSYS_PWR_CONN_ACK_S_OFFSET));
+			iounmap(q);
+		}
+	}
+
+	a3_rd(A3_CONSYS_BASE, 0x00, "mcu ", 0x1000);
+	a3_rd(A3_WIFI_BASE, 0x00, "wifi", 0x1000);
+}
+
+/* ---- runtime experiments -------------------------------------------- */
+static void a3_do_emi(void)
+{
+	struct device_node *np;
+	struct resource r;
+	void __iomem *p;
+	u32 val;
+
+	np = of_find_compatible_node(NULL, NULL, "mediatek,consys-reserve-memory");
+	if (!np)
+		np = of_find_node_by_name(NULL, "consys-reserve-memory");
+	if (np && !of_address_to_resource(np, 0, &r))
+		pr_info("A3 CONSYS[emi]: reserve 0x%pa..0x%pa\n", &r.start, &r.end);
+	else
+		pr_info("A3 CONSYS[emi]: no address on the reservation node\n");
+	if (np)
+		of_node_put(np);
+
+	p = ioremap(A3_INFRA_AO_BASE, A3_INFRA_AO_SIZE);
+	if (!p)
+		return;
+	val = readl(p + INFRA_EMI_MAPPING);
+	pr_info("A3 CONSYS[emi]: MAPPING = 0x%08x\n", val);
+	val = readl(p + INFRA_EMI_PERI_MAPPING);
+	pr_info("A3 CONSYS[emi]: PERI    = 0x%08x\n", val);
+	iounmap(p);
+	pr_info("A3 CONSYS[emi]: read-only probe done (no write yet)\n");
+}
+
+static void a3_do_osc(void)
+{
+	void __iomem *p = ioremap(A3_INFRA_AO_BASE, A3_INFRA_AO_SIZE);
+	u32 v;
+
+	if (!p)
+		return;
+	v = readl(p + INFRA_AP2CONN_OSC_EN);
+	pr_info("A3 CONSYS[osc]: OSC_EN before 0x%08x\n", v);
+	writel(v | AP2CONN_WAKEUP, p + INFRA_AP2CONN_OSC_EN);
+	pr_info("A3 CONSYS[osc]: OSC_EN after  0x%08x\n",
+		readl(p + INFRA_AP2CONN_OSC_EN));
+	iounmap(p);
+}
+
+static ssize_t a3_proc_write(struct file *f, const char __user *ubuf,
+			     size_t len, loff_t *off)
+{
+	char cmd[32] = { 0 };
+	size_t n = min(len, sizeof(cmd) - 1);
+
+	if (copy_from_user(cmd, ubuf, n))
+		return -EFAULT;
+	strim(cmd);
+	pr_info("A3 CONSYS: cmd '%s'\n", cmd);
+
+	if (!strcmp(cmd, "dump")) {
+		a3_rd(A3_INFRA_AO_BASE, INFRA0_CG_STA, "infra0_cg_sta", A3_INFRA_AO_SIZE);
+		a3_rd(A3_INFRA_AO_BASE, INFRA2_CG_STA, "infra2_cg_sta", A3_INFRA_AO_SIZE);
+		a3_rd(A3_INFRA_AO_BASE, INFRA_AP2CONN_OSC_EN, "osc_en", A3_INFRA_AO_SIZE);
+		a3_rd(A3_INFRA_AO_BASE, INFRA_EMI_MAPPING, "emi_map", A3_INFRA_AO_SIZE);
+		a3_rd(A3_SPM_BASE, SPM_PWR_STATUS, "pwr_status", 0x1000);
+		a3_rd(A3_SPM_BASE, CONN_PWR_CON, "conn_pwr_con", 0x1000);
+		a3_rd(A3_CONSYS_BASE, 0x00, "mcu ", 0x1000);
+		a3_rd(A3_WIFI_BASE, 0x00, "wifi", 0x1000);
+	} else if (!strcmp(cmd, "mcu")) {
+		a3_rd(A3_CONSYS_BASE, 0x00, "mcu ", 0x1000);
+		a3_rd(A3_WIFI_BASE, 0x00, "wifi", 0x1000);
+	} else if (!strcmp(cmd, "osc")) {
+		a3_do_osc();
+	} else if (!strcmp(cmd, "emi")) {
+		a3_do_emi();
+	} else if (!strcmp(cmd, "spmon")) {
+		a3_boot_sequence();
+	} else if (!strcmp(cmd, "rgu")) {
+		pr_warn("A3 CONSYS: reading 0x10007000, a freeze here is the answer\n");
+		a3_rd(A3_RGU_BASE, 0x00, "rgu ", 0x1000);
+	} else if (!strcmp(cmd, "hifon")) {
+		pr_warn("A3 CONSYS: reading 0x18007000, a freeze here is the answer\n");
+		a3_rd(A3_HIF_ON_BASE, 0x00, "hifon", 0x1000);
+	} else {
+		pr_info("A3 CONSYS: cmds = dump|mcu|osc|emi|spmon|rgu|hifon\n");
+	}
+	return len;
+}
+
+/* Gate for the in-tree vendor wmt driver: it is built in, but its probe is
+ * made to return -EPROBE_DEFER until someone sets this, so a broken power-on
+ * sequence cannot take the boot down.  Writing 1 to /proc/a3wmt flips it and
+ * rescans the platform bus, which retries the deferred probe. */
+int a3_wmt_allow_probe;
+EXPORT_SYMBOL_GPL(a3_wmt_allow_probe);
+
+static ssize_t a3wmt_write(struct file *f, const char __user *ubuf,
+			   size_t len, loff_t *off)
+{
+	char c;
+	int ret;
+
+	if (copy_from_user(&c, ubuf, 1))
+		return -EFAULT;
+	if (c == '1') {
+		pr_info("A3 WMT: allowing probe, rescanning platform bus\n");
+		a3_wmt_allow_probe = 1;
+		ret = bus_rescan_devices(&platform_bus_type);
+		pr_info("A3 WMT: bus_rescan_devices -> %d\n", ret);
+	} else {
+		pr_info("A3 WMT: probe stays gated (write 1 to enable)\n");
+	}
+	return len;
+}
+
+static const struct proc_ops a3wmt_proc_ops = {
+	.proc_write = a3wmt_write,
+};
+
+/* A3LOG: dmesg is a shared ring buffer and the WMT/STP code prints per-packet
+ * traces, so every interesting boot-time message gets pushed out before it can
+ * be read back.  Keep a small dedicated log that only A3 probes write to, and
+ * expose it read-only as /proc/a3log.
+ */
+#define A3LOG_SIZE 16384
+static char a3log_buf[A3LOG_SIZE];
+static size_t a3log_len;
+static DEFINE_SPINLOCK(a3log_lock);
+
+void a3log(const char *fmt, ...)
+{
+	va_list ap;
+	unsigned long flags;
+	int n;
+
+	spin_lock_irqsave(&a3log_lock, flags);
+	if (a3log_len < A3LOG_SIZE - 1) {
+		va_start(ap, fmt);
+		n = vsnprintf(a3log_buf + a3log_len, A3LOG_SIZE - a3log_len, fmt, ap);
+		va_end(ap);
+		if (n > 0) {
+			if ((size_t)n >= A3LOG_SIZE - a3log_len)
+				a3log_len = A3LOG_SIZE - 1;
+			else
+				a3log_len += n;
+		}
+	}
+	spin_unlock_irqrestore(&a3log_lock, flags);
+}
+
+static ssize_t a3log_read(struct file *f, char __user *ubuf,
+			  size_t len, loff_t *off)
+{
+	return simple_read_from_buffer(ubuf, len, off, a3log_buf, a3log_len);
+}
+
+static ssize_t a3log_write(struct file *f, const char __user *ubuf,
+			   size_t len, loff_t *off)
+{
+	/* writing anything clears the log */
+	unsigned long flags;
+
+	spin_lock_irqsave(&a3log_lock, flags);
+	a3log_len = 0;
+	spin_unlock_irqrestore(&a3log_lock, flags);
+	return len;
+}
+
+static const struct proc_ops a3log_proc_ops = {
+	.proc_read = a3log_read,
+	.proc_write = a3log_write,
+};
+
+static const struct proc_ops a3_proc_ops = {
+	.proc_write = a3_proc_write,
+};
+
+static int __init a3_consys_power_init(void)
+{
+	a3_boot_sequence();
+	if (!proc_create("a3consys", 0200, NULL, &a3_proc_ops))
+		pr_warn("A3 CONSYS: cannot create /proc/a3consys\n");
+	else
+		pr_info("A3 CONSYS: /proc/a3consys ready (dump|mcu|osc|emi|spmon|rgu|hifon)\n");
+	if (!proc_create("a3log", 0600, NULL, &a3log_proc_ops))
+		pr_warn("A3 LOG: cannot create /proc/a3log\n");
+	else
+		pr_info("A3 LOG: /proc/a3log ready (read to dump, write to clear)\n");
+	if (!proc_create("a3wmt", 0200, NULL, &a3wmt_proc_ops))
+		pr_warn("A3 WMT: cannot create /proc/a3wmt\n");
+	else
+		pr_info("A3 WMT: gated; write 1 to /proc/a3wmt to run the vendor probe\n");
+	return 0;
+}
+subsys_initcall(a3_consys_power_init);
diff --git a/arch/arm64/kernel/a3-gpu-power.c b/arch/arm64/kernel/a3-gpu-power.c
new file mode 100644
index 000000000..3229a948a
--- /dev/null
+++ b/arch/arm64/kernel/a3-gpu-power.c
@@ -0,0 +1,153 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * TEMPORARY bring-up aid for the OPPO A3 (MT6771) GPU / panfrost.
+ *
+ * History of this hack (see docs/worklog.md for the full evidence chain):
+ *   v154..v157 used the MT8173 scpsys offsets (SPM_MFG_PWR_CON 0x214,
+ *   SPM_PWR_STATUS 0x60c). On MT6771 those are simply different registers:
+ *   the 0x2c0/0x2c4 writes read back 0 and panfrost kept failing with
+ *   "gpu soft/hard reset timed out" (-110) on every boot.
+ *
+ * The REAL MT6771 register map comes from the vendor tree,
+ *   drivers/clk/mediatek/clk-mt6771-pg.c  ("MTCMOS" section):
+ *
+ *   SPM base 0x10006000:
+ *     PWR_STATUS        0x0180   PWR_STATUS_2ND     0x0184
+ *     MFG_PWR_CON       0x0338   sta BIT(4)  SRAM_PDN BIT(8) ACK BIT(12)
+ *     MFG_ASYNC_PWR_CON 0x0334   sta BIT(23)
+ *     MFG_2D_PWR_CON    0x0348   sta BIT(22) SRAM_PDN BIT(8) ACK BIT(12)
+ *     MFG_CORE0_PWR_CON 0x034c   sta BIT(7)  SRAM_PDN BIT(8) ACK BIT(12)
+ *     MFG_CORE1_PWR_CON 0x0310   sta BIT(20) SRAM_PDN BIT(8) ACK BIT(12)
+ *     PWR_RST_B BIT(0) PWR_ISO BIT(1) PWR_ON BIT(2) PWR_ON_2ND BIT(3)
+ *     PWR_CLK_DIS BIT(4)
+ *
+ *   Power-on order in the vendor gpufreq code is
+ *     MFG_ASYNC -> MFG -> MFG_CORE0 -> MFG_CORE1 -> MFG_2D
+ *   (mtk_gpufreq_core.c mt_gpufreq_enable_MTCMOS()), and none of the MFG
+ *   domains need bus-protect work on the power-ON direction.
+ *
+ * The MFG clock path was already verified alive on #35:
+ *   mfg_sel -> mfgpll_ck, MFGPLL enabled, BG3D gate clear.
+ * So the missing piece really was powering the MFG sub-domains at the right
+ * addresses.
+ *
+ * Delete once a proper MT6771 pm-domain driver exists.
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+#include <linux/kernel.h>
+
+#define A3_SPM_BASE		0x10006000UL
+#define A3_SPM_SIZE		0x1000
+
+#define SPM_PWR_STATUS		0x0180
+#define SPM_PWR_STATUS_2ND	0x0184
+
+#define MFG_ASYNC_PWR_CON	0x0334
+#define MFG_PWR_CON		0x0338
+#define MFG_CORE1_PWR_CON	0x0310
+#define MFG_2D_PWR_CON		0x0348
+#define MFG_CORE0_PWR_CON	0x034c
+
+#define PWR_RST_B		BIT(0)
+#define PWR_ISO			BIT(1)
+#define PWR_ON			BIT(2)
+#define PWR_ON_2ND		BIT(3)
+#define PWR_CLK_DIS		BIT(4)
+#define SRAM_PDN		BIT(8)
+#define SRAM_PDN_ACK		BIT(12)
+
+#define MFG_STA_MASK		BIT(4)
+#define MFG_CORE0_STA_MASK	BIT(7)
+#define MFG_CORE1_STA_MASK	BIT(20)
+#define MFG_2D_STA_MASK		BIT(22)
+#define MFG_ASYNC_STA_MASK	BIT(23)
+
+struct a3_gpu_domain {
+	const char *name;
+	u32 ctl_offs;
+	u32 sta_mask;
+	bool sram;
+};
+
+static const struct a3_gpu_domain a3_gpu_domains[] = {
+	{ "mfg_async", MFG_ASYNC_PWR_CON, MFG_ASYNC_STA_MASK, false },
+	{ "mfg",       MFG_PWR_CON,       MFG_STA_MASK,       true  },
+	{ "mfg_core0", MFG_CORE0_PWR_CON, MFG_CORE0_STA_MASK, true  },
+	{ "mfg_core1", MFG_CORE1_PWR_CON, MFG_CORE1_STA_MASK, true  },
+	{ "mfg_2d",    MFG_2D_PWR_CON,    MFG_2D_STA_MASK,    true  },
+};
+
+static int __init a3_gpu_domain_on(void __iomem *spm,
+				  const struct a3_gpu_domain *d)
+{
+	void __iomem *ctl = spm + d->ctl_offs;
+	u32 val, i;
+	int on = 0;
+
+	val = readl(ctl);
+	pr_info("A3 GPU: %-9s ctl=0x%08x\n", d->name, val);
+
+	if (!(val & PWR_ON)) {
+		writel(val | PWR_ON, ctl);
+		val = readl(ctl);
+		writel(val | PWR_ON_2ND, ctl);
+	}
+
+	for (i = 0; i < 2000; i++) {
+		u32 s1 = readl(spm + SPM_PWR_STATUS);
+		u32 s2 = readl(spm + SPM_PWR_STATUS_2ND);
+
+		if ((s1 & d->sta_mask) && (s2 & d->sta_mask)) {
+			on = 1;
+			break;
+		}
+		udelay(10);
+	}
+	if (!on)
+		pr_warn("A3 GPU: %-9s PWR_ACK timeout\n", d->name);
+
+	val = readl(ctl);
+	val &= ~PWR_CLK_DIS;
+	writel(val, ctl);
+	val &= ~PWR_ISO;
+	writel(val, ctl);
+	val |= PWR_RST_B;
+	writel(val, ctl);
+
+	if (d->sram) {
+		val = readl(ctl);
+		val &= ~SRAM_PDN;
+		writel(val, ctl);
+		for (i = 0; i < 2000; i++) {
+			if (!(readl(ctl) & SRAM_PDN_ACK))
+				break;
+			udelay(10);
+		}
+	}
+
+	pr_info("A3 GPU: %-9s done ctl=0x%08x ack=%d\n",
+		d->name, readl(ctl), on);
+	return 0;
+}
+
+static int __init a3_gpu_power_init(void)
+{
+	void __iomem *spm;
+	int i;
+
+	spm = ioremap(A3_SPM_BASE, A3_SPM_SIZE);
+	if (!spm) {
+		pr_warn("A3 GPU: cannot ioremap SPM\n");
+		return 0;
+	}
+
+	pr_info("A3 GPU: MT6771 MFG power-on (vendor clk-mt6771-pg.c map)\n");
+	for (i = 0; i < ARRAY_SIZE(a3_gpu_domains); i++)
+		a3_gpu_domain_on(spm, &a3_gpu_domains[i]);
+	iounmap(spm);
+	return 0;
+}
+subsys_initcall(a3_gpu_power_init);
