-		return ret;
+	if (pmic->irq <= 0) {
+		/* A3_NO_PMIC_IRQ: the OPPO A3 device tree describes the PMIC with the
+		 * vendor 4-cell interrupt specifier, which the mainline sysirq cannot
+		 * translate, so platform_get_irq() fails and the whole MFD bails out.
+		 * WiFi only needs the regmap (vcn28/vcn18/vcn33 regulators), not the
+		 * PMIC IRQ, so keep probing without interrupt support.
+		 */
+		dev_warn(&pdev->dev,
+			 "A3_NO_PMIC_IRQ: no PMIC irq (%d), continuing without irq support\n",
+			 pmic->irq);
+		pmic->irq = 0;
+		pmic->irq_domain = NULL;
+	} else {
+		ret = pmic_core->irq_init(pmic);
+		if (ret)
+			return ret;
+	}
 
 	ret = devm_mfd_add_devices(&pdev->dev, PLATFORM_DEVID_NONE,
 				   pmic_core->cells, pmic_core->cell_size,
 				   NULL, 0, pmic->irq_domain);
 	if (ret) {
-		irq_domain_remove(pmic->irq_domain);
+		if (pmic->irq_domain)
+			irq_domain_remove(pmic->irq_domain);
 		dev_err(&pdev->dev, "failed to add child devices: %d\n", ret);
 	}
 
