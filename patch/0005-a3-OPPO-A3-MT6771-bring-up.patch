diff --git a/drivers/extcon/extcon-a3-usb-id.c b/drivers/extcon/extcon-a3-usb-id.c
new file mode 100644
index 000000000..286978b3c
--- /dev/null
+++ b/drivers/extcon/extcon-a3-usb-id.c
@@ -0,0 +1,118 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OPPO A3 (MT6771) USB ID extcon.
+ *
+ * The vendor device trees (all oppo6771 projects) put the USB ID pin on
+ * GPIO 41 ("gpio41_mode1_iddig").  mainline has no MT6771 pinctrl driver, so
+ * there is no gpiochip and the generic extcon-usb-gpio cannot be used.
+ *
+ * Instead this tiny driver reads the GPIO input register directly and reports
+ * EXTCON_USB_HOST, which mtu3 consumes through its "extcon" property.  That
+ * gives automatic OTG role switching:
+ *   ID low  (OTG adapter plugged) -> host
+ *   ID high (normal cable / none) -> device
+ *
+ * Register layout (vendor pinctrl-mtk-mt6771.h, mtk_pin_info_datain):
+ *   pin 41 -> DI register 0x210, bit 9
+ */
+#include <linux/delay.h>
+#include <linux/extcon-provider.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/workqueue.h>
+
+#define A3_GPIO_BASE	0x10005000
+#define A3_GPIO_SIZE	0x1000
+#define A3_ID_REG	0x210
+#define A3_ID_BIT	9
+#define A3_ID_POLL_MS	200
+
+struct a3_usb_id {
+	struct device *dev;
+	struct extcon_dev *edev;
+	void __iomem *base;
+	struct delayed_work dwork;
+	int last;
+};
+
+static const unsigned int a3_usb_id_cables[] = {
+	EXTCON_USB_HOST,
+	EXTCON_NONE,
+};
+
+static void a3_usb_id_work(struct work_struct *work)
+{
+	struct a3_usb_id *id = container_of(to_delayed_work(work),
+					    struct a3_usb_id, dwork);
+	u32 val = readl(id->base + A3_ID_REG);
+	int host = !(val & BIT(A3_ID_BIT));
+
+	if (host != id->last) {
+		id->last = host;
+		extcon_set_state_sync(id->edev, EXTCON_USB_HOST, host);
+		dev_info(id->dev, "A3 USB ID: %s (DI=0x%08x)\n",
+			 host ? "host (OTG plugged)" : "device", val);
+	}
+
+	schedule_delayed_work(&id->dwork, msecs_to_jiffies(A3_ID_POLL_MS));
+}
+
+static int a3_usb_id_probe(struct platform_device *pdev)
+{
+	struct a3_usb_id *id;
+	int ret;
+
+	id = devm_kzalloc(&pdev->dev, sizeof(*id), GFP_KERNEL);
+	if (!id)
+		return -ENOMEM;
+	id->dev = &pdev->dev;
+	id->last = -1;
+
+	id->base = devm_ioremap(&pdev->dev, A3_GPIO_BASE, A3_GPIO_SIZE);
+	if (!id->base)
+		return dev_err_probe(&pdev->dev, -ENOMEM, "cannot map GPIO block\n");
+
+	id->edev = devm_extcon_dev_allocate(&pdev->dev, a3_usb_id_cables);
+	if (IS_ERR(id->edev))
+		return PTR_ERR(id->edev);
+
+	ret = devm_extcon_dev_register(&pdev->dev, id->edev);
+	if (ret)
+		return ret;
+
+	INIT_DELAYED_WORK(&id->dwork, a3_usb_id_work);
+	schedule_delayed_work(&id->dwork, 0);
+
+	platform_set_drvdata(pdev, id);
+	dev_info(&pdev->dev, "A3 USB ID extcon registered (GPIO41, DI[0x%x] bit %d)\n",
+		 A3_ID_REG, A3_ID_BIT);
+	return 0;
+}
+
+static void a3_usb_id_remove(struct platform_device *pdev)
+{
+	struct a3_usb_id *id = platform_get_drvdata(pdev);
+
+	cancel_delayed_work_sync(&id->dwork);
+}
+
+static const struct of_device_id a3_usb_id_of_match[] = {
+	{ .compatible = "oppo,a3-usb-id" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a3_usb_id_of_match);
+
+static struct platform_driver a3_usb_id_driver = {
+	.driver = {
+		.name = "a3-usb-id",
+		.of_match_table = a3_usb_id_of_match,
+	},
+	.probe = a3_usb_id_probe,
+	.remove = a3_usb_id_remove,
+};
+module_platform_driver(a3_usb_id_driver);
+
+MODULE_DESCRIPTION("OPPO A3 USB ID extcon (GPIO41)");
+MODULE_LICENSE("GPL");
