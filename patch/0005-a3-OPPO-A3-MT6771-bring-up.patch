+ * (RQST0 bit0, divider 128/3, Vref 1800 mV, 15-bit) and exposes it as a
+ * power_supply.  Charger status bits are not documented for MT6357, so the
+ * relevant register/bit is configurable at runtime through module parameters
+ * (a3_st_reg / a3_st_bit / a3_st_invert); the debugfs "regs" file dumps the
+ * charger register block so the correct bit can be identified by comparing a
+ * plugged and an unplugged dump.
+ */
+
+#include <linux/debugfs.h>
+#include <linux/io.h>
+#include <linux/delay.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/power_supply.h>
+#include <linux/fs.h>
+#include <linux/string.h>
+#include <linux/regmap.h>
+
+#define A3_AUXADC_RQST0		0x110e
+#define A3_AUXADC_ADC0		0x1088
+#define A3_AUXADC_RDY		BIT(15)
+#define A3_AUXADC_MASK		GENMASK(14, 0)
+#define A3_AUXADC_TIMEOUT_US	32000
+#define A3_AUXADC_POLL_US	100
+#define A3_AUXADC_AVG_US	10
+
+#define A3_CHR_TOP_CON0		0xa88
+#define A3_CHR_TOP_CON6		0xa94
+#define A3_CHR_CON0		0xb88
+#define A3_CHR_CON9		0xb9a
+
+/* raw * 1800 mV * 128 / (32768 * 3) => raw * 2.34375 mV */
+#define A3_BATADC_TO_MV(raw)	div_u64((u64)(raw) * 1800 * 128, 32768 * 3)
+
+struct a3_battery {
+	struct device *dev;
+	struct regmap *regmap;
+	struct power_supply *bat;
+	int cap_smooth;
+	int q_valid;
+	int q_started;
+	int q_mah1000;
+	bool q_seeded;		/* seeding is deferred to the property path */
+	unsigned long q_jiffies;
+	int cap_valid;
+	int cap_persisted;
+	int st_last;		/* last reported status */
+	int st_pending;
+	bool st_pending_valid;
+	unsigned long st_pending_jiffies;
+	unsigned long cap_jiffies;
+	/* PRESENT TECHNOLOGY HEALTH STATUS VOLTAGE_NOW CAPACITY
+	 * CHARGE_COUNTER CHARGE_FULL CURRENT_NOW TEMP + headroom */
+	enum power_supply_property props[12];
+	int nprops;
+	struct power_supply_desc desc;
+	struct dentry *debugfs;
+	struct mutex lock;
+};
+
+static int a3_i_reg = 0x108a;
+module_param(a3_i_reg, int, 0644);
+MODULE_PARM_DESC(a3_i_reg, "AUXADC register for battery current (0 = disabled)");
+static int a3_i_num = 15;
+module_param(a3_i_num, int, 0644);
+static int a3_i_den = 3;
+module_param(a3_i_den, int, 0644);
+static int a3_i_offset;
+module_param(a3_i_offset, int, 0644);
+MODULE_PARM_DESC(a3_i_offset, "Offset in mA added to the current reading");
+
+static int a3_t_reg;
+module_param(a3_t_reg, int, 0644);
+MODULE_PARM_DESC(a3_t_reg, "AUXADC register for battery temperature (0 = disabled)");
+static int a3_t_num = 8;
+module_param(a3_t_num, int, 0644);
+static int a3_t_den = 1;
+module_param(a3_t_den, int, 0644);
+static int a3_t_offset;
+module_param(a3_t_offset, int, 0644);
+MODULE_PARM_DESC(a3_t_offset, "Offset in 0.001C added to the temperature reading");
+
+#define A3_FG_MAX_MA	8000	/* reject |I| beyond 8 A as noise */
+static int a3_fg_k = 61;        /* mA per FG LSB x1000 (0.061 mA) */
+static int a3_batt_mah = 3300;
+static int a3_v_reg = 0x1088;
+module_param(a3_batt_mah, int, 0644);
+static int a3_cap_src = 1; /* 0=voltage table, 1=coulomb counter (matches Android) */
+module_param(a3_cap_src, int, 0644);
+module_param(a3_v_reg, int, 0644);
+MODULE_PARM_DESC(a3_v_reg, "AUXADC result register for battery voltage");
+
+static int a3_v_num = 3;
+module_param(a3_v_num, int, 0644);
+MODULE_PARM_DESC(a3_v_num, "Voltage divider numerator (mV ratio)");
+
+static int a3_v_den = 1;
+module_param(a3_v_den, int, 0644);
+MODULE_PARM_DESC(a3_v_den, "Voltage divider denominator");
+
+static int a3_st_reg;
+module_param(a3_st_reg, int, 0644);
+MODULE_PARM_DESC(a3_st_reg, "Charger status register offset (0 = disabled)");
+static int a3_st_bit = -1;
+module_param(a3_st_bit, int, 0644);
+MODULE_PARM_DESC(a3_st_bit, "Charger status bit inside a3_st_reg");
+static bool a3_st_invert;
+module_param(a3_st_invert, bool, 0644);
+MODULE_PARM_DESC(a3_st_invert, "Invert the charger status bit meaning");
+
+static int a3_batadc_raw(struct a3_battery *bat, int *out)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_write(bat->regmap, A3_AUXADC_RQST0, BIT(0));
+	if (ret)
+		return ret;
+	fsleep(A3_AUXADC_AVG_US);
+
+	ret = regmap_read_poll_timeout(bat->regmap, A3_AUXADC_ADC0, val,
+				       val & A3_AUXADC_RDY, A3_AUXADC_POLL_US,
+				       A3_AUXADC_TIMEOUT_US);
+	regmap_write(bat->regmap, A3_AUXADC_RQST0, 0);
+	if (ret)
+		return ret;
+
+	*out = val & A3_AUXADC_MASK;
+	return 0;
+}
+
+/* voltage -> capacity curve taken from the vendor ZCV table */
+static int a3_voltage_to_capacity(int mv)
+{
+	static const struct { int mv, pct; } tbl[] = {
+	{ 3191, 0 },
+	{ 3450, 5 },
+	{ 3537, 15 },
+	{ 3620, 22 },
+	{ 3683, 30 },
+	{ 3715, 35 },
+	{ 3747, 40 },
+	{ 3779, 45 },
+	{ 3810, 50 },
+	{ 3850, 57 },
+	{ 3889, 65 },
+	{ 3937, 70 },
+	{ 3984, 75 },
+	{ 4080, 80 },
+	{ 4164, 85 },
+	{ 4219, 90 },
+	{ 4272, 95 },
+	{ 4335, 100 },
+};
+	int i;
+
+	if (mv <= tbl[0].mv)
+		return 0;
+	for (i = 1; i < ARRAY_SIZE(tbl); i++) {
+		if (mv <= tbl[i].mv) {
+			int dv = tbl[i].mv - tbl[i - 1].mv;
+			int dp = tbl[i].pct - tbl[i - 1].pct;
+
+			return tbl[i - 1].pct + (mv - tbl[i - 1].mv) * dp / dv;
+		}
+	}
+	return 100;
+}
+
+/*
+ * The mainline kernel has no fuel gauge for this PMIC, so capacity can only be
+ * estimated from the battery voltage.  That estimate is bad while charging
+ * (the charger lifts the terminal voltage), so clamp the rate of change:
+ * at most 1 % per 30 s, and never a jump.  It is an estimate, not a gauge.
+ */
+#define A3_CAP_FILE "/var/lib/a3-battery/capacity"
+
+#define A3_CHARGE_FILE	"/var/lib/a3-battery/charge"
+#define A3_SEED_FILE	"/var/lib/a3-battery/seed"
+
+/* accumulated charge in mAh*1000, persisted so reboots keep the count */
+static int a3_charge_load(struct a3_battery *bat)
+{
+	struct file *f;
+	char buf[32];
+	loff_t pos = 0;
+	ssize_t n;
+	long v;
+
+	f = filp_open(A3_CHARGE_FILE, O_RDONLY, 0);
+	if (IS_ERR(f))
+		return -ENOENT;
+	n = kernel_read(f, buf, sizeof(buf) - 1, &pos);
+	filp_close(f, NULL);
+	if (n <= 0)
+		return -EIO;
+	buf[n] = 0;
+	if (kstrtol(buf, 10, &v))
+		return -EINVAL;
+	bat->q_mah1000 = (int)v;
+	return 0;
+}
+
+static void a3_charge_persist(struct a3_battery *bat)
+{
+	struct file *f;
+	char buf[32];
+	loff_t pos = 0;
+	int len;
+
+	f = filp_open(A3_CHARGE_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (IS_ERR(f))
+		return;
+	len = scnprintf(buf, sizeof(buf), "%d\n", bat->q_mah1000);
+	kernel_write(f, buf, len, &pos);
+	filp_close(f, NULL);
+}
+
+static int a3_cap_load(void)
+{
+	struct file *f;
+	char buf[16];
+	ssize_t n;
+	int v = -1;
+
+	f = filp_open(A3_CAP_FILE, O_RDONLY, 0);
+	if (IS_ERR(f))
+		return -1;
+	n = kernel_read(f, buf, sizeof(buf) - 1, &f->f_pos);
+	filp_close(f, NULL);
+	if (n <= 0)
+		return -1;
+	buf[n] = 0;
+	if (kstrtoint(buf, 10, &v))
+		return -1;
+	if (v < 0 || v > 100)
+		return -1;
+	return v;
+}
+
+static void a3_cap_persist(int cap)
+{
+	struct file *f;
+	char buf[16];
+	int len;
+
+	f = filp_open(A3_CAP_FILE, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+	if (IS_ERR(f))
+		return;
+	len = scnprintf(buf, sizeof(buf), "%d", cap);
+	kernel_write(f, buf, len, &f->f_pos);
+	filp_close(f, NULL);
+}
+
+/* userspace can drop a value here to re-align the counter at any time */
+static void a3_apply_seed_runtime(struct a3_battery *bat)
+{
+	struct file *sf;
+
+	/*
+	 * Touching the filesystem before init is done hangs: built-in drivers
+	 * can be asked for properties while the root filesystem is still the
+	 * early ramfs.  Only look at the seed file once the system is running.
+	 */
+	if (system_state != SYSTEM_RUNNING)
+		return;
+
+	char buf[32];
+	loff_t pos = 0;
+	ssize_t n;
+	long v;
+
+	sf = filp_open(A3_SEED_FILE, O_RDONLY, 0);
+	if (IS_ERR(sf))
+		return;
+	n = kernel_read(sf, buf, sizeof(buf) - 1, &pos);
+	filp_close(sf, NULL);
+	if (n <= 0 || kstrtol(buf, 10, &v))
+		return;
+
+	bat->q_mah1000 = (int)v;
+	a3_charge_persist(bat);
+	bat->cap_valid = 0;		/* let the smoothing restart from the new value */
+	pr_info("a3-battery: runtime seed applied (%d)\n", bat->q_mah1000);
+}
+
+static int a3_cap_update(struct a3_battery *bat, int mv)
+{
+	int target;
+
+	if (a3_cap_src)
+		a3_apply_seed_runtime(bat);
+
+	if (a3_cap_src && bat->q_seeded) {
+		int full = a3_batt_mah * 1000;
+
+		target = full > 0 ? (int)div_s64((s64)bat->q_mah1000 * 100, full) : 0;
+		if (target < 0)
+			target = 0;
+		if (target > 100)
+			target = 100;
+	} else {
+		target = a3_voltage_to_capacity(mv);
+	}
+
+	/*
+	 * The 1 %/30 s clamp exists to hide jitter in the voltage table.  The
+	 * coulomb counter is already smooth (and re-seeding must take effect
+	 * immediately), so bypass the clamp entirely for that source.
+	 */
+	if (a3_cap_src && bat->q_seeded) {
+		if (target != bat->cap_smooth || !bat->cap_valid) {
+			bat->cap_smooth = target;
+			bat->cap_valid = 1;
+			bat->cap_jiffies = jiffies;
+			a3_cap_persist(bat);
+			bat->cap_persisted = target;
+			a3_charge_persist(bat);
+		}
+		return target;
+	}
+
+	if (!bat->cap_valid) {
+		bat->cap_smooth = target;
+		bat->cap_valid = 1;
+		bat->cap_jiffies = jiffies;
+		return bat->cap_smooth;
+	}
+
+	if (time_before(jiffies, bat->cap_jiffies + msecs_to_jiffies(30000)))
+		return bat->cap_smooth;
+
+	if (target > bat->cap_smooth)
+		bat->cap_smooth += min(target - bat->cap_smooth, 1);
+	else if (target < bat->cap_smooth)
+		bat->cap_smooth -= min(bat->cap_smooth - target, 1);
+	bat->cap_jiffies = jiffies;
+	if (bat->cap_smooth != bat->cap_persisted) {
+		a3_cap_persist(bat->cap_smooth);
+		bat->cap_persisted = bat->cap_smooth;
+	}
+	if (a3_cap_src)
+		a3_charge_persist(bat);
+	return bat->cap_smooth;
+}
+
+#define A3_ST_DEBOUNCE_MS	8000
+
+/*
+ * The charger's state machine toggles between fast-charge and charge-done every
+ * few seconds when the pack is nearly full (termination current is reached,
+ * the cell relaxes, charging restarts).  Debounce so userspace sees a stable
+ * value instead of a flicker between CHARGING and FULL.
+ */
+/* first run: derive a starting charge from the voltage table */
+static int a3_v_read_raw(struct a3_battery *bat, int *out);
+static int a3_raw_to_mv(int raw);
+
+static void a3_seed_charge(struct a3_battery *bat)
+{
+	/* never touch the filesystem before the root filesystem is up */
+	if (system_state != SYSTEM_RUNNING)
+		return;
+
+	/* a one-shot value written by userspace wins, e.g. to match Android */
+	{
+		struct file *sf;
+		char sbuf[32];
+		loff_t spos = 0;
+		ssize_t sn;
+		long sv;
+
+		sf = filp_open(A3_SEED_FILE, O_RDONLY, 0);
+		if (!IS_ERR(sf)) {
+			sn = kernel_read(sf, sbuf, sizeof(sbuf) - 1, &spos);
+			filp_close(sf, NULL);
+			if (sn > 0 && !kstrtol(sbuf, 10, &sv)) {
+				bat->q_mah1000 = (int)sv;
+				a3_charge_persist(bat);
+				pr_info("a3-battery: seeded from override %d\n", bat->q_mah1000);
+				return;
+			}
+		}
+	}
+	int raw, mv, cap;
+
+	if (!a3_cap_src)
+		return;
+	if (!a3_charge_load(bat))
+		return;			/* resumed from the persisted value */
+
+	if (!a3_v_read_raw(bat, &raw)) {
+		mv = a3_raw_to_mv(raw);
+		cap = a3_voltage_to_capacity(mv);
+		switch (cap) {
+		default:
+			bat->q_mah1000 = (int)div_s64((s64)cap * a3_batt_mah * 1000, 100);
+			break;
+		}
+	} else {
+		bat->q_mah1000 = a3_batt_mah * 1000 / 2;
+	}
+	a3_charge_persist(bat);
+	pr_info("a3-battery: seeded charge %d mAh*1000 (%d%%)\n",
+		bat->q_mah1000, bat->q_mah1000 / (a3_batt_mah * 10 ? a3_batt_mah * 10 : 1));
+}
+
+static int a3_st_debounce(struct a3_battery *bat, int raw)
+{
+	if (bat->st_last < 0) {
+		bat->st_last = raw;
+		return bat->st_last;
+	}
+
+	if (raw == bat->st_last) {
+		bat->st_pending_valid = false;
+		return bat->st_last;
+	}
+
+	if (!bat->st_pending_valid || raw != bat->st_pending) {
+		bat->st_pending = raw;
+		bat->st_pending_valid = true;
+		bat->st_pending_jiffies = jiffies;
+		return bat->st_last;
+	}
+
+	if (time_after(jiffies,
+		       bat->st_pending_jiffies + msecs_to_jiffies(A3_ST_DEBOUNCE_MS))) {
+		bat->st_last = raw;
+		bat->st_pending_valid = false;
+	}
+
+	return bat->st_last;
+}
+
+static int a3_charger_online(struct a3_battery *bat)
+{
+	u32 val;
+	int ret;
+
+	if (a3_st_reg <= 0 || a3_st_bit < 0 || a3_st_bit > 15)
+		return -EOPNOTSUPP;
+
+	ret = regmap_read(bat->regmap, a3_st_reg, &val);
+	if (ret)
+		return ret;
+
+	ret = !!(val & BIT(a3_st_bit));
+	return a3_st_invert ? !ret : ret;
+}
+
+/*
+ * Read-only probe for GPIO 41, the USB ID pin (vendor DTS: gpio41_mode1_iddig).
+ * The MT6771 pinctrl driver is missing in mainline, so map the GPIO block
+ * directly.  GPIO 41 -> bank 2, DI register 0x220, bit 9.
+ */
+#define A3_GPIO_BASE   0x10005000
+#define A3_GPIO_SIZE   0x1000
+#define A3_ID_DI_REG   0x220
+#define A3_ID_BIT      9
+
+static void __iomem *a3_gpio;
+
+static int a3_id_show(struct seq_file *s, void *unused)
+{
+	u32 di, dir, mode[4];
+	int i;
+
+	if (!a3_gpio) {
+		a3_gpio = ioremap(A3_GPIO_BASE, A3_GPIO_SIZE);
+		if (!a3_gpio)
+			return -ENOMEM;
+	}
+
+	di = readl(a3_gpio + A3_ID_DI_REG);
+	dir = readl(a3_gpio + 0x020);
+	for (i = 0; i < 4; i++)
+		mode[i] = readl(a3_gpio + 0x000 + i * 0x4);
+
+	seq_printf(s, "GPIO41 level=%d (DI[0x220]=0x%08x bit9=%d)\n",
+		   !!(di & BIT(A3_ID_BIT)), di, !!(di & BIT(A3_ID_BIT)));
+
+	/* full picture: mode / dir / do / di */
+	for (i = 0; i < 8; i++)
+		seq_printf(s, "MODE[0x%03x]=%08x\n", i * 4, readl(a3_gpio + i * 4));
+	for (i = 0; i < 4; i++)
+		seq_printf(s, "DIR[0x%03x]=%08x DO[0x%03x]=%08x DI[0x%03x]=%08x\n",
+			   i * 0x10, readl(a3_gpio + 0x000 + i * 0x10),
+			   0x100 + i * 0x10, readl(a3_gpio + 0x100 + i * 0x10),
+			   0x200 + i * 0x10, readl(a3_gpio + 0x200 + i * 0x10));
+	{
+		u32 mreg = readl(a3_gpio + (41 / 8) * 4);
+		u32 nib = (mreg >> ((41 % 8) * 4)) & 0xf;
+		u32 dreg = readl(a3_gpio + 0x000 + (41 / 16) * 0x10);
+		u32 ireg = readl(a3_gpio + 0x200 + (41 / 16) * 0x10);
+
+		seq_printf(s, "pin41: MODE[0x%03x]=%08x nibble=%u\n",
+			   (41 / 8) * 4, mreg, nib);
+		seq_printf(s, "pin41: DIR[0x%03x]=%08x bit=%u  DI[0x%03x]=%08x bit=%u\n",
+			   (41 / 16) * 0x10, dreg, !!(dreg & BIT(41 % 16)),
+			   0x200 + (41 / 16) * 0x10, ireg, !!(ireg & BIT(41 % 16)));
+	}
+	seq_printf(s, "ID pin meaning: 0 => OTG cable (host), 1 => no OTG (device)\n");
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(a3_id);
+
+static int a3_v_read_raw(struct a3_battery *bat, int *out);
+static int a3_raw_to_mv(int raw);
+
+static int a3_adc_read(struct a3_battery *bat, int reg, int *out)
+{
+	u32 val;
+	int ret;
+
+	if (reg <= 0)
+		return -EOPNOTSUPP;
+
+	int bit = (reg - A3_AUXADC_ADC0) / 2;
+
+	if (bit < 0 || bit > 15)
+		return -EINVAL;
+	ret = regmap_write(bat->regmap, A3_AUXADC_RQST0, BIT(bit));
+	if (ret)
+		return ret;
+	fsleep(2000);
+	ret = regmap_read(bat->regmap, reg, &val);
+	regmap_write(bat->regmap, A3_AUXADC_RQST0, 0);
+	if (ret)
+		return ret;
+	*out = val & 0x7fff;
+	return 0;
+}
+/*
+ * ISENSE (AUXADC CH1) gives the battery current.  There is no public formula for
+ * the MT6358 sense network, so the scale is a module parameter that has to be
+ * calibrated once (see a3-pinctrl.md / a3-battery.md): set the charger to two
+ * known currents and read the raw value for each.
+ */
+static int a3_isense(struct a3_battery *bat, int *ua)
+{
+	int raw, mv;
+
+	if (a3_adc_read(bat, a3_i_reg, &raw))
+		return -EIO;
+	if (raw == 0)
+		return -ENODATA;
+	mv = a3_raw_to_mv(raw);
+	*ua = (mv - a3_i_offset) * (a3_i_num ? a3_i_num : 1) / (a3_i_den ? a3_i_den : 1);
+	return 0;
+}
+
+/* coulomb counter: integrate the current into a charge reservoir */
+#define A3_FG_CAR0	0x0d14
+#define A3_FG_CAR1	0x0d16
+#define A3_FG_IAVG0	0x0d30
+#define A3_FG_IAVG1	0x0d32
+#define A3_FG_CON1	0x0d0a
+
+/*
+ * MT6358 fuel gauge: a conversion has to be kicked through FGADC_CON1, then the
+ * average current is in FGADC_IAVG_CON0/1 (low 16 bits / bits 27:16, bit 11 of
+ * the high word is the sign: 1 = discharging).
+ */
+static int a3_fg_read(struct a3_battery *bat, int *ma)
+{
+	u32 lo, hi, val;
+	s64 raw;
+	int ret;
+
+	ret = regmap_read(bat->regmap, A3_FG_CON1, &val);
+	if (ret)
+		return ret;
+	regmap_write(bat->regmap, A3_FG_CON1, (val & ~0xFu) | 0x1);
+	fsleep(1500);
+	ret = regmap_read(bat->regmap, A3_FG_IAVG0, &lo);
+	if (!ret)
+		ret = regmap_read(bat->regmap, A3_FG_IAVG1, &hi);
+	regmap_write(bat->regmap, A3_FG_CON1, (val & ~0xFu) | 0x8);
+	regmap_write(bat->regmap, A3_FG_CON1, val & ~0xFu);
+	if (ret)
+		return ret;
+
+	/*
+	 * IAVG is a 28-bit signed value: bits 27:16 live in FGADC_IAVG_CON1[11:0]
+	 * and bits 15:0 in FGADC_IAVG_CON0.  The vendor code does
+	 *     if (sign_bit) reg = 0xfffffff - reg + 1;
+	 * which is just two's complement.  Skipping it turns a small discharge
+	 * current into a huge positive number (about 131 A) and any coulomb
+	 * counter built on top of it runs away.
+	 */
+	raw = ((s64)(hi & 0xfff) << 16) | (lo & 0xffff);
+	if (raw & 0x8000000LL)		/* sign bit of the 28-bit field */
+		raw -= 0x10000000LL;
+
+	*ma = div_s64(raw * a3_fg_k, 1000);
+	if (*ma > A3_FG_MAX_MA || *ma < -A3_FG_MAX_MA)
+		return -ENODATA;	/* implausible sample: skip, do not integrate */
+	return 0;
+}
+
+static void a3_coulomb_update(struct a3_battery *bat)
+{
+	int ua, ma;
+	unsigned long now = jiffies, dt;
+	s64 dq;
+
+	if (!bat->q_valid) {
+		bat->q_valid = 1;
+		bat->q_jiffies = now;
+		return;
+	}
+	dt = now - bat->q_jiffies;
+	if (dt < HZ)
+		return;
+	if (a3_fg_read(bat, &ma))
+		return;
+	ua = ma * 1000;
+	/* microamp-seconds -> mAh*1000: uA*s/3600 */
+	dq = div_s64((s64)ua * (s64)dt / HZ, 3600);
+	bat->q_mah1000 += (int)dq;
+	if (bat->q_mah1000 < 0)
+		bat->q_mah1000 = 0;
+	if (bat->q_mah1000 > a3_batt_mah * 1000)
+		bat->q_mah1000 = a3_batt_mah * 1000;
+	bat->q_jiffies = now;
+}
+
+static int a3_chg_status(struct a3_battery *bat, int *out)
+{
+	struct power_supply *chg;
+	union power_supply_propval v = {0};
+	int ret;
+
+	chg = power_supply_get_by_name("bq24190-charger");
+	if (!chg)
+		return -ENODEV;
+	ret = power_supply_get_property(chg, POWER_SUPPLY_PROP_STATUS, &v);
+	if (!ret)
+		*out = v.intval;
+	power_supply_put(chg);
+	return ret;
+}
+
+
+
+static int a3_v_read_raw(struct a3_battery *bat, int *out)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_write(bat->regmap, A3_AUXADC_RQST0, BIT(0));
+	if (ret)
+		return ret;
+	fsleep(2000);
+	ret = regmap_read(bat->regmap, a3_v_reg, &val);
+	regmap_write(bat->regmap, A3_AUXADC_RQST0, 0);
+	if (ret)
+		return ret;
+	*out = val & 0x7fff;
+	return 0;
+}
+
+static int a3_raw_to_mv(int raw)
+{
+	u64 num = (u64)raw * 1800 * (u64)(a3_v_num ? a3_v_num : 1);
+
+	return (int)div_u64(num, 32768ULL * (u64)(a3_v_den ? a3_v_den : 1));
+}
+
+static int a3_battery_get_property(struct power_supply *psy,
+				   enum power_supply_property psp,
+				   union power_supply_propval *val)
+{
+	struct a3_battery *bat = power_supply_get_drvdata(psy);
+	int raw, mv, online = 0;
+
+	if (a3_cap_src && !bat->q_seeded && system_state == SYSTEM_RUNNING) {
+		a3_seed_charge(bat);
+		bat->q_seeded = true;	/* retried on later reads until it runs */
+	}
+	a3_coulomb_update(bat);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_PRESENT:
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_TECHNOLOGY:
+		val->intval = POWER_SUPPLY_TECHNOLOGY_LION;
+		return 0;
+	case POWER_SUPPLY_PROP_HEALTH:
+		val->intval = POWER_SUPPLY_HEALTH_GOOD;
+		return 0;
+	default:
+		break;
+	}
+
+	mutex_lock(&bat->lock);
+	if (a3_v_read_raw(bat, &raw)) {
+		mutex_unlock(&bat->lock);
+		return -EIO;
+	}
+	mutex_unlock(&bat->lock);
+	mv = a3_raw_to_mv(raw);
+
+	switch (psp) {
+	case POWER_SUPPLY_PROP_VOLTAGE_NOW:
+		val->intval = mv * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_COUNTER:
+		val->intval = bat->q_mah1000;	/* uAh, same unit as Android */
+		return 0;
+	case POWER_SUPPLY_PROP_CHARGE_FULL:
+		val->intval = a3_batt_mah * 1000;
+		return 0;
+	case POWER_SUPPLY_PROP_CAPACITY:
+		/*
+		 * Single path on purpose: this used to bypass a3_cap_update() when
+		 * a3_cap_src was set, which silently skipped the seeding and the
+		 * debounce logic that live there.
+		 */
+		val->intval = a3_cap_update(bat, mv);
+		return 0;
+	case POWER_SUPPLY_PROP_CURRENT_NOW: {
+		int raw_i = 0, ma;
+
+		if (!a3_fg_read(bat, &ma)) {
+			val->intval = ma * 1000;
+			return 0;
+		}
+		if (a3_i_reg <= 0)
+			return -EOPNOTSUPP;
+		if (a3_adc_read(bat, a3_i_reg, &raw_i))
+			return -EIO;
+		val->intval = (div_u64((u64)raw_i * (a3_i_num ? a3_i_num : 1),
+				       (a3_i_den ? a3_i_den : 1)) + a3_i_offset) * 1000;
+		return 0;
+	}
+	case POWER_SUPPLY_PROP_TEMP: {
+		int raw_t = 0;
+
+		if (a3_t_reg <= 0)
+			return -EOPNOTSUPP;
+		if (a3_adc_read(bat, a3_t_reg, &raw_t))
+			return -EIO;
+		val->intval = (int)div_u64((u64)raw_t * (a3_t_num ? a3_t_num : 1),
+					   (a3_t_den ? a3_t_den : 1)) + a3_t_offset;
+		return 0;
+	}
+	case POWER_SUPPLY_PROP_STATUS: {
+		int st;
+
+		/* prefer the real charger driver (bq24190), debounced */
+		if (!a3_chg_status(bat, &st)) {
+			val->intval = a3_st_debounce(bat, st);
+			return 0;
+		}
+		online = a3_charger_online(bat);
+		if (online > 0)
+			val->intval = POWER_SUPPLY_STATUS_CHARGING;
+		else if (online == 0)
+			val->intval = POWER_SUPPLY_STATUS_DISCHARGING;
+		else
+			val->intval = POWER_SUPPLY_STATUS_UNKNOWN;
+		return 0;
+	}
+	case POWER_SUPPLY_PROP_ONLINE:
+		online = a3_charger_online(bat);
+		val->intval = online > 0;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static enum power_supply_property a3_usb_props[] = {
+	POWER_SUPPLY_PROP_ONLINE,
+};
+
+static const struct power_supply_desc a3_battery_desc = {
+	.name		= "battery",
+	.type		= POWER_SUPPLY_TYPE_BATTERY,
+	.get_property	= a3_battery_get_property,
+};
+
+static const struct power_supply_desc a3_usb_desc = {
+	.name		= "usb",
+	.type		= POWER_SUPPLY_TYPE_USB,
+	.properties	= a3_usb_props,
+	.num_properties	= ARRAY_SIZE(a3_usb_props),
+	.get_property	= a3_battery_get_property,
+};
+
+static int a3_regs_show(struct seq_file *s, void *unused)
+{
+	struct a3_battery *bat = s->private;
+	int reg, ret;
+	u32 val;
+
+	for (reg = A3_CHR_TOP_CON0; reg <= A3_CHR_TOP_CON6; reg += 2) {
+		ret = regmap_read(bat->regmap, reg, &val);
+		if (!ret)
+			seq_printf(s, "CHR_TOP_CON%d(0x%04x) = 0x%04x\n",
+				   (reg - A3_CHR_TOP_CON0) / 2, reg, val);
+	}
+	for (reg = A3_CHR_CON0; reg <= A3_CHR_CON9; reg += 2) {
+		ret = regmap_read(bat->regmap, reg, &val);
+		if (!ret)
+			seq_printf(s, "CHR_CON%d(0x%04x)     = 0x%04x\n",
+				   (reg - A3_CHR_CON0) / 2, reg, val);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(a3_regs);
+
+static const struct file_operations a3_adc_fops;
+
+static int a3_battery_probe(struct platform_device *pdev)
+{
+	struct a3_battery *bat;
+	struct power_supply_config cfg = {};
+	struct device *mfd = pdev->dev.parent;
+	int ret;
+
+	bat = devm_kzalloc(&pdev->dev, sizeof(*bat), GFP_KERNEL);
+	if (!bat)
+		return -ENOMEM;
+	bat->dev = &pdev->dev;
+	bat->st_last = -1;
+	mutex_init(&bat->lock);
+
+	if (!mfd || !mfd->parent)
+		return dev_err_probe(&pdev->dev, -ENODEV, "no PMIC parent\n");
+
+	bat->regmap = dev_get_regmap(mfd->parent, NULL);
+	if (!bat->regmap)
+		return dev_err_probe(&pdev->dev, -ENODEV, "no pwrap regmap\n");
+
+	cfg.drv_data = bat;
+	cfg.fwnode = dev_fwnode(&pdev->dev);
+
+	/*
+	 * Only advertise properties we can really answer.  current/temp need
+	 * calibration (a3_i_reg / a3_t_reg) and status needs the charger-detect
+	 * bit (a3_st_reg/a3_st_bit); advertising them unconditionally makes the
+	 * core log "failed to report `current_now' property: -95".
+	 */
+	{
+		int saved = a3_cap_load();
+
+		if (saved >= 0) {
+			bat->cap_smooth = saved;
+			bat->cap_valid = 1;
+			bat->cap_jiffies = jiffies;
+		}
+	}
+
+	bat->nprops = 0;
+	bat->props[bat->nprops++] = POWER_SUPPLY_PROP_PRESENT;
+	bat->props[bat->nprops++] = POWER_SUPPLY_PROP_TECHNOLOGY;
+	bat->props[bat->nprops++] = POWER_SUPPLY_PROP_HEALTH;
+	bat->props[bat->nprops++] = POWER_SUPPLY_PROP_STATUS;
+	bat->props[bat->nprops++] = POWER_SUPPLY_PROP_VOLTAGE_NOW;
+	bat->props[bat->nprops++] = POWER_SUPPLY_PROP_CAPACITY;
+	bat->props[bat->nprops++] = POWER_SUPPLY_PROP_CHARGE_COUNTER;
+	bat->props[bat->nprops++] = POWER_SUPPLY_PROP_CHARGE_FULL;
+	if (a3_i_reg > 0)
+		bat->props[bat->nprops++] = POWER_SUPPLY_PROP_CURRENT_NOW;
+	if (a3_t_reg > 0)
+		bat->props[bat->nprops++] = POWER_SUPPLY_PROP_TEMP;
+
+	bat->desc = a3_battery_desc;
+	bat->desc.properties = bat->props;
+	bat->desc.num_properties = bat->nprops;
+
+	bat->bat = devm_power_supply_register(&pdev->dev, &bat->desc, &cfg);
+	if (IS_ERR(bat->bat))
+		return PTR_ERR(bat->bat);
+
+	struct power_supply *usb;
+
+	usb = devm_power_supply_register(&pdev->dev, &a3_usb_desc, &cfg);
+	if (IS_ERR(usb))
+		return PTR_ERR(usb);
+
+
+	bat->debugfs = debugfs_create_dir("a3_battery", NULL);
+	if (!IS_ERR_OR_NULL(bat->debugfs)) {
+		debugfs_create_file("regs", 0444, bat->debugfs, bat, &a3_regs_fops);
+		debugfs_create_file("adc", 0444, bat->debugfs, bat, &a3_adc_fops);
+		debugfs_create_file("id", 0444, bat->debugfs, bat, &a3_id_fops);
+	}
+
+	dev_info(&pdev->dev, "A3 battery registered (status reg %d bit %d)\n",
+		 a3_st_reg, a3_st_bit);
+	return 0;
+}
+
+static int a3_adc_show(struct seq_file *s, void *unused)
+{
+	struct a3_battery *bat = s->private;
+	u32 val;
+	int i, ret;
+
+	mutex_lock(&bat->lock);
+	/* request BATADC (RQST0 bit0) and give it time to convert */
+	regmap_write(bat->regmap, A3_AUXADC_RQST0, BIT(0));
+	fsleep(2000);
+	for (i = 0; i <= 33; i++) {
+		u32 reg = A3_AUXADC_ADC0 + i * 2;
+		ret = regmap_read(bat->regmap, reg, &val);
+		if (ret)
+			continue;
+		seq_printf(s, "ADC%d(0x%04x) = 0x%04x  raw=%u  mv_x5=%u mv_x42=%u\n",
+			   i, reg, val, val & 0x7fff,
+			   (unsigned int)((val & 0x7fff) * 1800 * 5 / 32768),
+			   (unsigned int)((val & 0x7fff) * 1800 * 128 / (32768 * 3)));
+	}
+	regmap_write(bat->regmap, A3_AUXADC_RQST0, 0);
+	mutex_unlock(&bat->lock);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(a3_adc);
+
+static const struct of_device_id a3_battery_of_match[] = {
+	{ .compatible = "oppo,a3-battery" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a3_battery_of_match);
+
+static struct platform_driver a3_battery_driver = {
+	.driver = {
+		.name = "a3-battery",
+		.of_match_table = a3_battery_of_match,
+	},
+	.probe = a3_battery_probe,
+};
+module_platform_driver(a3_battery_driver);
+
+MODULE_DESCRIPTION("OPPO A3 MT6357 battery driver");
+MODULE_LICENSE("GPL");
