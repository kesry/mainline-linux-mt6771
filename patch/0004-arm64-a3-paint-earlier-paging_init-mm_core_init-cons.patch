From 7273615dfe206445afe615a28c1e387d45d3d9a0 Mon Sep 17 00:00:00 2001
From: oppoa3-port <port@oppoa3.local>
Date: Wed, 4 Nov 2026 00:46:02 +0800
Subject: [PATCH 04/12] arm64: a3: paint earlier (paging_init / mm_core_init /
 console_init)

The first attempt only painted from early_initcall onwards and the screen
never changed, which means the kernel dies before do_initcalls.

Add paint calls at the earliest points where ioremap works:
  RED    after paging_init()      (setup_arch almost done)
  GREEN  after mm_core_init()
  BLUE   after console_init()
  YELLOW at early_initcall        (do_initcalls started)
  WHITE  at device_initcall       (drivers probing, wdt should be stopped)

No colour at all now means the kernel dies in the decompressor or in device
tree parsing, before setup_arch() finishes.
---
 arch/arm64/kernel/a3-early-paint.c | 18 +++++++++++-------
 arch/arm64/kernel/setup.c          |  8 ++++++++
 init/main.c                        | 14 ++++++++++++++
 3 files changed, 33 insertions(+), 7 deletions(-)

diff --git a/arch/arm64/kernel/a3-early-paint.c b/arch/arm64/kernel/a3-early-paint.c
index fd8d39675..1f626135d 100644
--- a/arch/arm64/kernel/a3-early-paint.c
+++ b/arch/arm64/kernel/a3-early-paint.c
@@ -26,6 +26,7 @@
 #include <linux/init.h>
 #include <linux/io.h>
 #include <linux/kernel.h>
+#include <linux/export.h>
 
 #define A3_FB_BASE	0x7d170000UL
 #define A3_FB_WIDTH	1080
@@ -33,7 +34,7 @@
 #define A3_FB_STRIDE	4		/* bytes per pixel (32bpp) */
 #define A3_FB_PAINT	(A3_FB_WIDTH * A3_FB_BAND * A3_FB_STRIDE)
 
-static void __init a3_paint(u32 colour)
+void a3_paint(u32 colour)
 {
 	void __iomem *fb;
 	unsigned long i;
@@ -48,15 +49,18 @@ static void __init a3_paint(u32 colour)
 	iounmap(fb);
 }
 
-static int __init a3_paint_early(void)		{ a3_paint(0x00ff0000); return 0; }
-static int __init a3_paint_core(void)		{ a3_paint(0x0000ff00); return 0; }
-static int __init a3_paint_postcore(void)	{ a3_paint(0x000000ff); return 0; }
-static int __init a3_paint_arch(void)		{ a3_paint(0x00ffff00); return 0; }
-static int __init a3_paint_subsys(void)		{ a3_paint(0x00ff00ff); return 0; }
-static int __init a3_paint_fs(void)		{ a3_paint(0x0000ffff); return 0; }
+static int __init a3_paint_early(void)		{ a3_paint(0x00ffff00); return 0; }  /* YELLOW */
+static int __init a3_paint_core(void)		{ a3_paint(0x00ffff00); return 0; }  /* YELLOW */
+static int __init a3_paint_postcore(void)	{ a3_paint(0x00ffff00); return 0; }  /* YELLOW */
+static int __init a3_paint_arch(void)		{ a3_paint(0x00ffff00); return 0; }  /* YELLOW */
+static int __init a3_paint_subsys(void)		{ a3_paint(0x00ffff00); return 0; }  /* YELLOW */
+static int __init a3_paint_fs(void)		{ a3_paint(0x00ffff00); return 0; }  /* YELLOW */
 static int __init a3_paint_device(void)		{ a3_paint(0x00ffffff); return 0; }
 
 early_initcall(a3_paint_early);
+
+/* Called from setup_arch()/start_kernel() before initcalls exist. */
+EXPORT_SYMBOL_GPL(a3_paint);
 core_initcall(a3_paint_core);
 postcore_initcall(a3_paint_postcore);
 arch_initcall(a3_paint_arch);
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index 8185979f0..5965caa03 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -334,6 +334,14 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 
 	paging_init();
 
+#ifdef CONFIG_A3_EARLY_PAINT
+	{
+		extern void a3_paint(u32 colour);
+		/* RED: paging_init() done -- earliest point where ioremap works */
+		a3_paint(0x00ff0000);
+	}
+#endif
+
 	acpi_table_upgrade();
 
 	/* Parse the ACPI tables for possible boot-time configuration */
diff --git a/init/main.c b/init/main.c
index 34bb284f6..329e0363f 100644
--- a/init/main.c
+++ b/init/main.c
@@ -933,6 +933,13 @@ void start_kernel(void)
 	sort_main_extable();
 	trap_init();
 	mm_core_init();
+
+#ifdef CONFIG_A3_EARLY_PAINT
+	{
+		extern void a3_paint(u32 colour);
+		a3_paint(0x0000ff00);	/* GREEN: mm_core_init() done */
+	}
+#endif
 	poking_init();
 	ftrace_init();
 
@@ -1009,6 +1016,13 @@ void start_kernel(void)
 	 * this. But we do want output early, in case something goes wrong.
 	 */
 	console_init();
+
+#ifdef CONFIG_A3_EARLY_PAINT
+	{
+		extern void a3_paint(u32 colour);
+		a3_paint(0x000000ff);	/* BLUE: console_init() done */
+	}
+#endif
 	if (panic_later)
 		panic("Too many boot %s vars at `%s'", panic_later,
 		      panic_param);
