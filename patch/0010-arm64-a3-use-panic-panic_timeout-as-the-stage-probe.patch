From 5dee6bb529aec14f601640b551c1bc0567c9e6b8 Mon Sep 17 00:00:00 2001
From: oppoa3-port <port@oppoa3.local>
Date: Wed, 4 Nov 2026 22:00:37 +0800
Subject: [PATCH 10/12] arm64: a3: use panic()+panic_timeout as the stage probe

Writing the TopRGU SWRST register directly was never validated, so a slow
reboot could be a false negative. panic() goes through the standard
panic -> kernel_restart -> PSCI reset path, which is the same mechanism the
vendor kernel relies on, and with CONFIG_PANIC_TIMEOUT=5 the reboot is quick
enough to read as a signal.
---
 arch/arm64/kernel/setup.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
index b4c0ca469..5ec61e742 100644
--- a/arch/arm64/kernel/setup.c
+++ b/arch/arm64/kernel/setup.c
@@ -299,7 +299,7 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 		 * board come back in seconds instead of the ~30 s the LK watchdog
 		 * takes, which is the only liveness signal this board gives us.
 		 */
-		a3_force_reset_early();
+		panic("A3PROBE: reached early_ioremap_init");
 	}
 #endif
 
