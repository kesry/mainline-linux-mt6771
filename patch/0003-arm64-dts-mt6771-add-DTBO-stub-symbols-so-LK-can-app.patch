From 39159b92796242aa1807ba034de1ae17512e08a7 Mon Sep 17 00:00:00 2001
From: oppoa3-port <port@oppoa3.local>
Date: Wed, 4 Nov 2026 01:18:58 +0800
Subject: [PATCH 3/6] arm64: dts: mt6771: add DTBO stub symbols so LK can apply
 the vendor overlay

ROOT CAUSE of the kernel never starting.

LK applies the vendor odmdtbo overlay (entry 2 of 13) onto the boot.img DTB
before jumping to the kernel. That overlay resolves its targets by SYMBOL
NAME: its /__fixups__ node lists 54 symbols (chosen, pio, i2c0..i2c11, mtkfb,
touch, scp, consys, ...) that must exist in the base DTB's /__symbols__.

A hand-written minimal DTB has no /__symbols__ at all, so ufdt_apply_overlay()
fails, LK logs "boot image dtb_overlay fail" and refuses to boot -- the
kernel is never executed, the screen keeps showing the fastboot UI and the
watchdog resets the board ~30 s later.

Fix: emit inert stub nodes carrying those 53 labels (chosen already existed)
and build the DTB with -@ so /__symbols__ is generated. Nothing in mainline
matches "oppo,a3-dtbo-stub" and the stubs are disabled, so the overlay's
content lands on nodes the kernel ignores.
---
 arch/arm64/boot/dts/mediatek/Makefile         |   2 +
 .../boot/dts/mediatek/mt6771-oppo-a3.dts      | 232 +++++++++++++++++-
 2 files changed, 233 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/mediatek/Makefile b/arch/arm64/boot/dts/mediatek/Makefile
index c79cebf7a..5c1ffa072 100644
--- a/arch/arm64/boot/dts/mediatek/Makefile
+++ b/arch/arm64/boot/dts/mediatek/Makefile
@@ -2,6 +2,8 @@
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt2712-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6755-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6771-oppo-a3.dtb
+# -@ emits /__symbols__, required so LK can apply the vendor odmdtbo overlay
+DTC_FLAGS_mt6771-oppo-a3 := -@
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6779-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-evb.dtb
 dtb-$(CONFIG_ARCH_MEDIATEK) += mt6795-sony-xperia-m5.dtb
diff --git a/arch/arm64/boot/dts/mediatek/mt6771-oppo-a3.dts b/arch/arm64/boot/dts/mediatek/mt6771-oppo-a3.dts
index ecbabe37d..000f44fcf 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771-oppo-a3.dts
+++ b/arch/arm64/boot/dts/mediatek/mt6771-oppo-a3.dts
@@ -29,7 +29,7 @@ / {
 	model = "OPPO A3 (PADT00)";
 	compatible = "oppo,a3", "mediatek,mt6771";
 
-	chosen {
+	chosen: chosen {
 		#address-cells = <2>;
 		#size-cells = <2>;
 		ranges;
@@ -90,4 +90,234 @@ ramoops: ramoops@54410000 {
 			ftrace-size = <0x0>;
 		};
 	};
