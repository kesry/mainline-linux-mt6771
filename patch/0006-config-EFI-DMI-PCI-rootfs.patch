Subject: [PATCH 6/6] =?UTF-8?q?config:=20=E5=BC=80=E5=90=AF=20EFI/DMI/PCI?=
 =?UTF-8?q?=EF=BC=8C=E6=94=AF=E6=8C=81=E9=A3=9E=E7=89=9B=20rootfs?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

飞牛 libtrim_machine 通过 SMBIOS/DMI 识别机器，arm64 上 CONFIG_DMI
依赖 CONFIG_EFI，非 UEFI 设备也必须显式开启，否则 sysinfo_service
崩溃、连锁导致 Web API 全 502。

新增:
  CONFIG_EFI=y
  CONFIG_PCI=y / PCI_MSI
  CONFIG_DMI_SYSFS=y
  CONFIG_FW_CFG_SYSFS=y / FW_CFG_SYSFS_CMDLINE=y
---
 arch/arm64/configs/a3_defconfig | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/configs/a3_defconfig b/arch/arm64/configs/a3_defconfig
index ae24245e3..7c7f432e1 100644
--- a/arch/arm64/configs/a3_defconfig
+++ b/arch/arm64/configs/a3_defconfig
@@ -1,3 +1,4 @@
+CONFIG_EFI=y
 CONFIG_SYSVIPC=y
 CONFIG_POSIX_MQUEUE=y
 CONFIG_NO_HZ_IDLE=y
@@ -80,7 +81,6 @@ CONFIG_PARAVIRT=y
 CONFIG_COMPAT=y
 CONFIG_CMDLINE="console=ttyS0,921600n8 console=tty0 loglevel=7 panic=0 root=PARTUUID=6fce83a6-5273-4748-1145-c205ebb4b8ad rootwait rw clk_ignore_unused pd_ignore_unused fw_devlink=off ramoops.mem_address=0x54410000 ramoops.mem_size=0xE0000 ramoops.console_size=0x40000 ramoops.record_size=0x20000 ramoops.pmsg_size=0x20000 ramoops.ftrace_size=0x20000"
 CONFIG_CMDLINE_FORCE=y
-# CONFIG_EFI is not set
 CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
 CONFIG_VIRTUALIZATION=y
 CONFIG_KVM=y
@@ -144,6 +144,7 @@ CONFIG_NL80211_TESTMODE=y
 CONFIG_CFG80211_WEXT=y
 CONFIG_MAC80211=y
 CONFIG_NET_9P=y
+CONFIG_PCI=y
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
 CONFIG_FW_LOADER_USER_HELPER=y
@@ -152,7 +153,10 @@ CONFIG_TEGRA_ACONNECT=m
 CONFIG_MHI_BUS=m
 CONFIG_ARM_SCPI_PROTOCOL=y
 CONFIG_ARM_SDE_INTERFACE=y
+CONFIG_DMI_SYSFS=y
 CONFIG_RASPBERRYPI_FIRMWARE=y
+CONFIG_FW_CFG_SYSFS=y
+CONFIG_FW_CFG_SYSFS_CMDLINE=y
 CONFIG_INTEL_STRATIX10_SERVICE=y
 CONFIG_INTEL_STRATIX10_RSU=m
 CONFIG_MTK_ADSP_IPC=m
@@ -699,7 +703,6 @@ CONFIG_RESET_IMX7=y
 CONFIG_RESET_MESON_AUDIO_ARB=m
 CONFIG_RESET_QCOM_AOSS=y
 CONFIG_RESET_QCOM_PDC=m
-CONFIG_RESET_RASPBERRYPI=y
 CONFIG_RESET_RZG2L_USBPHY_CTRL=y
 CONFIG_RESET_TI_SCI=y
 CONFIG_PHY_XGENE=y
