+/*
+ * Stop the TopRGU watchdog that LK leaves armed.
+ *
+ * Why this is needed: the vendor DTB only describes the watchdog as
+ * `a7_wdt@f0400000 { compatible = "mediatek,a7_wdt"; }`, which the mainline
+ * MEDIATEK_WATCHDOG driver does not match (it binds
+ * "mediatek,mt6589-wdt" at 0x10007000). So nothing ever stops the timer LK
+ * started, and the board resets ~60 s after handover -- which looks exactly
+ * like "the kernel hung", even when it booted all the way into the initramfs.
+ *
+ * Evidence that the kernel really gets that far: the initcall paint ladder
+ * reaches GREY (device_initcall), the very last level.
+ *
+ * WDT_MODE needs the magic key 0x22000000 in the top bits or the write is
+ * ignored by the hardware -- that is why the reset probe in this same file
+ * writes 0x22000030 rather than 0x30. Writing the key with every other bit
+ * clear leaves WDT_ENABLE (bit 0) at 0, i.e. the timer stops. Writing
+ * WDT_SWRST (0x1209 to +0x14) would reset the SoC instead, so don't.
+ */
+/*
+ * Register values below are taken from the vendor driver
+ * build/ref/oppo-official-r11/drivers/watchdog/mtk_wdt.c:
+ *
+ *   WDT_MODE   0x00  WDT_MODE_EN 0, AUTO_START 4, IRQ_EN 3, DUAL_EN 6,
+ *                    WDT_MODE_KEY 0x22000000
+ *   WDT_RST    0x08  reload value is **0x1971**, not 1
+ *   WDT_SWRST  0x14  0x1209 (that resets the SoC -- never write it here)
+ *
+ * The first attempt used `writel(1, base + 0x08)` for the ping, which the
+ * hardware ignores, so the timer was never actually petted and the board kept
+ * resetting ~60 s after handover (v97/v100).
+ *
+ * Disable is a read-modify-write: read WDT_MODE, clear DUAL_EN|IRQ_EN|EN|
+ * AUTO_START, OR in the key, write back. Writing the key alone (v97) is not
+ * what the vendor driver does.
+ */
+#define A3_TOPRGU_BASE		0x10007000UL
+#define A3_TOPRGU_WDT_MODE	0x00
+#define A3_TOPRGU_WDT_RST	0x08
+#define A3_WDT_MODE_KEY		0x22000000U
+#define A3_WDT_MODE_EN		(1U << 0)
+#define A3_WDT_MODE_IRQ_EN	(1U << 3)
+#define A3_WDT_MODE_AUTO_START	(1U << 4)
+#define A3_WDT_MODE_DUAL_EN	(1U << 6)
+#define A3_WDT_RST_RELOAD	0x1971U
+
+static void __iomem *a3_wdt_base;
+static struct timer_list a3_wdt_timer;
+
+static void a3_wdt_pet(struct timer_list *t)
+{
+	if (a3_wdt_base) {
+		writel(A3_WDT_RST_RELOAD, a3_wdt_base + A3_TOPRGU_WDT_RST);
+		mod_timer(t, jiffies + 5 * HZ);
+	}
+}
+
+void a3_stop_watchdog(void)
+{
+	u32 reg;
+
+	a3_wdt_base = ioremap(A3_TOPRGU_BASE, 0x1000);
+	if (!a3_wdt_base)
+		return;
+
+	/* same sequence as the vendor driver's disable path */
+	reg = readl(a3_wdt_base + A3_TOPRGU_WDT_MODE);
+	reg &= ~(A3_WDT_MODE_DUAL_EN | A3_WDT_MODE_IRQ_EN |
+		 A3_WDT_MODE_EN | A3_WDT_MODE_AUTO_START);
+	reg |= A3_WDT_MODE_KEY;
+	writel(reg, a3_wdt_base + A3_TOPRGU_WDT_MODE);
+
+	/* and keep pinging it with the correct reload value, belt and braces */
+	writel(A3_WDT_RST_RELOAD, a3_wdt_base + A3_TOPRGU_WDT_RST);
+	timer_setup(&a3_wdt_timer, a3_wdt_pet, 0);
+	mod_timer(&a3_wdt_timer, jiffies + 5 * HZ);
+}
+EXPORT_SYMBOL_GPL(a3_stop_watchdog);
+
+/*
+ * Diagnostic: report what WDT_MODE actually reads back after we tried to
+ * disable it. Returns -1 if the register was never mapped.
+ *
+ * The caller paints one of two colours from this, which answers a question
+ * that cannot be answered any other way on this board: did our write to
+ * TopRGU take effect at all? If WDT_ENABLE is still set afterwards, the write
+ * is being ignored (register protected / needs a different sequence) and the
+ * ~60 s reset really is this watchdog. If it is clear, the reset comes from
+ * some other agent (a7_wdt, PMIC, ATF) and TopRGU is a red herring.
+ */
+int a3_wdt_mode_readback(void)
+{
+	if (!a3_wdt_base)
+		return -1;
+	return (int)readl(a3_wdt_base + A3_TOPRGU_WDT_MODE);
+}
+EXPORT_SYMBOL_GPL(a3_wdt_mode_readback);
