diff --git a/drivers/phy/mediatek/phy-mtk-tphy.c b/drivers/phy/mediatek/phy-mtk-tphy.c
index 3f7095ec5..42e25277e 100644
--- a/drivers/phy/mediatek/phy-mtk-tphy.c
+++ b/drivers/phy/mediatek/phy-mtk-tphy.c
@@ -894,6 +894,32 @@ static void u2_phy_instance_power_on(struct mtk_tphy *tphy,
 
 	mtk_phy_clear_bits(com + U3P_U2PHYDTM1, P2C_RG_SESSEND);
 
+	/*
+	 * A3/MT6771 bring-up: the vendor mu3phy HAL explicitly forces the U2
+	 * PHY out of suspend (RG_SUSPENDM + FORCE_SUSPENDM) and clears the
+	 * DP/DM pulldown / UART mux on every power-on. Mainline only does the
+	 * SUSPENDM bits when avoid_rx_sen_degradation is set (it is not for
+	 * generic-tphy-v2), so on this SoC the PHY stays in suspend and never
+	 * drives D+ even though the gadget reports "pullup D+".
+	 *
+	 * Bit definitions here are the same ones this driver already uses
+	 * (P2C_*), and the vendor header confirms identical bit positions.
+	 */
+	if (IS_ENABLED(CONFIG_A3_MTU3_IGNORE_CLKCHECK)) {
+		mtk_phy_clear_bits(com + U3P_U2PHYDTM0,
+				   P2C_FORCE_UART_EN | P2C_FORCE_SUSPENDM);
+		mtk_phy_clear_bits(com + U3P_U2PHYDTM1, P2C_RG_UART_EN);
+		mtk_phy_set_bits(com + U3P_U2PHYDTM0,
+				 P2C_RG_SUSPENDM | P2C_FORCE_SUSPENDM);
+		mtk_phy_clear_bits(com + U3P_U2PHYACR4, P2C_U2_GPIO_CTR_MSK);
+		mtk_phy_clear_bits(com + U3P_USBPHYACR6, PA6_RG_U2_BC11_SW_EN);
+		/* Vendor mt6771 HAL: RG_SSUSB_VUSB09_ON at u3_sif2_base+0xB04
+		 * bit29. In mainline tphy that base is the port's port_base
