index 1a0cbaa40..efbbbed57 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2556,6 +2556,52 @@ config A3_EARLY_PAINT
 
 	  Say N for anything but bring-up.
 
+config A3_GPU_PWR
+	bool "Power up the MT6771 MFG (GPU) domains before panfrost probes"
+	depends on ARCH_MEDIATEK && DRM_PANFROST
+	help
+	  TEMPORARY bring-up aid for the OPPO A3 (MT6771).
+
+	  Mainline has no MT6771 scpsys/MTCMOS driver, so the GPU power domains
+	  stay off and panfrost's soft/hard reset times out with -ETIMEDOUT.
+	  This replays the generic MediaTek SPM power-on sequence at an
+	  early_initcall. See arch/arm64/kernel/a3-gpu-power.c for the register
+	  provenance. Delete once a proper MT6771 pm-domain driver exists.
+
+	  Say N for anything but bring-up.
+
+config A3_CONSYS_PWR
+	bool "Power up the MT6771 CONN domain (consys / MT6631) at initcall"
+	depends on ARCH_MEDIATEK
+	help
+	  TEMPORARY bring-up aid for the OPPO A3 (MT6771).
+
+	  Mainline has no MT6771 pm-domain driver, so the CONN power domain that
+	  feeds the on-SoC MT6631 connectivity subsystem is never enabled and the
+	  consys node never enumerates. This replays the vendor
+	  clk-mt6771-pg.c spm_mtcmos_ctrl_conn() power-on sequence. Delete once
+	  a proper MT6771 pm-domain driver exists.
+
+	  Say N for anything but bring-up.
+
+config A3_MTU3_IGNORE_CLKCHECK
+	bool "Do not fail mtu3 probe when the USB IP status bits look wrong"
+	depends on ARCH_MEDIATEK && USB_MTU3
+	help
+	  TEMPORARY bring-up aid for the OPPO A3 (MT6771).
+
+	  mtu3's ssusb_check_clocks() polls U3D_SSUSB_IP_PW_STS1/2 for
+	  SYSPLL/REF/SYS125 "stable" bits and fails probe with -ETIMEDOUT if they
+	  do not read as expected. On MT6771 the IP reports a newer version
+	  ("super-speed-plus") than the bits mainline checks for, and LK has
+	  already brought the PHY/PLL up before handing over, so the poll can
+	  fail even though the controller is usable.
+
+	  With this enabled the check becomes a warning instead of a hard
+	  failure, so gadget initialisation can be tried anyway.
+
+	  Say N for anything but bring-up.
+
 config A3_PANIC_AT_START_KERNEL
 	bool "Panic at the top of start_kernel()"
 	depends on A3_EARLY_PAINT
