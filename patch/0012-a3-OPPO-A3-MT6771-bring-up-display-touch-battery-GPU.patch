--- /dev/null
+++ b/drivers/pinctrl/mediatek/pinctrl-a3.c
@@ -0,0 +1,243 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * OPPO A3 (MT6771) pin controller / GPIO driver.
+ *
+ * mainline has no MT6771 pinctrl driver and the vendor ALPS tree only carries
+ * the register layout (no pin function table), so this driver provides:
+ *
+ *   - a gpiochip over the MT6771 GPIO block (0x10005000), using the per-pin
+ *     register offsets taken from the vendor pinctrl-mtk-mt6771.h tables
+ *   - a debugfs "mux" knob to change a pin's MODE field, which is what we need
+ *     to bring up buses (i2c5) whose pin muxing is normally done by LK and for
+ *     which no function table is available
+ *
+ * The tables are generated by gen_pin_tables.py from the vendor header.
+ */
+#include <linux/debugfs.h>
+#include <linux/gpio/driver.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/uaccess.h>
+
+#include "a3_pin_tables.h"
+
+#define A3_NGPIOS	191	/* DT gpio-ranges declares 191 */
+#define A3_GPIO_BASE	0x10005000
+#define A3_GPIO_SIZE	0x1000
+
+struct a3_pin {
+	struct device *dev;
+	void __iomem *base;
+	struct gpio_chip gc;
+};
+
+static inline u32 a3_read(struct a3_pin *p, u16 addr)
+{
+	return readl(p->base + (addr & ~0x3u));
+}
+
+static void a3_rmw(struct a3_pin *p, u16 addr, u8 bit, u8 width, u32 val)
+{
+	void __iomem *reg = p->base + (addr & ~0x3u);
+	u32 shift = (addr & 0x3) * 8 + bit;
+	u32 mask, v;
+
+	if (!width)
+		return;
+	mask = ((1u << width) - 1u) << shift;
+	v = readl(reg);
+	v = (v & ~mask) | ((val << shift) & mask);
+	writel(v, reg);
+}
+
+static u32 a3_read_field(struct a3_pin *p, u16 addr, u8 bit, u8 width)
+{
+	u32 v = a3_read(p, addr);
+	u32 shift = (addr & 0x3) * 8 + bit;
+
+	if (!width)
+		return 0;
+	return (v >> shift) & ((1u << width) - 1u);
+}
+
+static int a3_gpio_get_direction(struct gpio_chip *gc, unsigned int off)
+{
+	struct a3_pin *p = gpiochip_get_data(gc);
+
+	if (off >= A3_NPINS || off >= A3_NGPIOS)
+		return -EINVAL;
+	return a3_read_field(p, a3_dir_addr[off], a3_dir_bit[off], a3_dir_w[off])
+		? GPIO_LINE_DIRECTION_OUT : GPIO_LINE_DIRECTION_IN;
+}
+
+static int a3_gpio_direction_input(struct gpio_chip *gc, unsigned int off)
+{
+	struct a3_pin *p = gpiochip_get_data(gc);
+
+	if (off >= A3_NPINS || off >= A3_NGPIOS)
+		return -EINVAL;
+	a3_rmw(p, a3_mode_addr[off], a3_mode_bit[off], a3_mode_w[off], 0);	/* GPIO */
+	a3_rmw(p, a3_ies_addr[off], a3_ies_bit[off], a3_ies_w[off], 1);	/* input enable */
+	a3_rmw(p, a3_dir_addr[off], a3_dir_bit[off], a3_dir_w[off], 0);
+	return 0;
+}
+
+static int a3_gpio_direction_output(struct gpio_chip *gc, unsigned int off, int val)
+{
+	struct a3_pin *p = gpiochip_get_data(gc);
+
+	if (off >= A3_NPINS || off >= A3_NGPIOS)
+		return -EINVAL;
+	a3_rmw(p, a3_mode_addr[off], a3_mode_bit[off], a3_mode_w[off], 0);
+	a3_rmw(p, a3_dataout_addr[off], a3_dataout_bit[off], a3_dataout_w[off], !!val);
+	if (val) {
+		a3_rmw(p, a3_ies_addr[off], a3_ies_bit[off], a3_ies_w[off], 1);
+		a3_rmw(p, a3_dir_addr[off], a3_dir_bit[off], a3_dir_w[off], 0);
+	} else {
+		a3_rmw(p, a3_dir_addr[off], a3_dir_bit[off], a3_dir_w[off], 1);
+	}
+	return 0;
+}
+
+static int a3_gpio_get(struct gpio_chip *gc, unsigned int off)
+{
+	struct a3_pin *p = gpiochip_get_data(gc);
+
+	if (off >= A3_NPINS || off >= A3_NGPIOS)
+		return -EINVAL;
+	return a3_read_field(p, a3_datain_addr[off], a3_datain_bit[off], a3_datain_w[off]);
+}
+
+/*
+ * A3: emulate open-drain. The MT6771 pad has no per-pin open-drain mode, and
+ * i2c-gpio is our only GPIO consumer, so "1" releases the line (input, pulled
+ * up externally) instead of driving it high.
+ */
+static void a3_gpio_set(struct gpio_chip *gc, unsigned int off, int val)
+{
+	struct a3_pin *p = gpiochip_get_data(gc);
+
+	if (off >= A3_NPINS || off >= A3_NGPIOS)
+		return;
+
+	a3_rmw(p, a3_dataout_addr[off], a3_dataout_bit[off], a3_dataout_w[off], !!val);
+	if (val) {
+		a3_rmw(p, a3_ies_addr[off], a3_ies_bit[off], a3_ies_w[off], 1);
+		a3_rmw(p, a3_dir_addr[off], a3_dir_bit[off], a3_dir_w[off], 0);
+	} else {
+		a3_rmw(p, a3_dir_addr[off], a3_dir_bit[off], a3_dir_w[off], 1);
+	}
+}
+
+/* ------------------------------------------------------------------ debugfs */
+
+static int a3_mux_show(struct seq_file *s, void *unused)
+{
+	struct a3_pin *p = s->private;
+	int i;
+
+	seq_printf(s, "pin mode dir ien ie io  (base %#x)\n", A3_GPIO_BASE);
+	for (i = 0; i < A3_NPINS; i++) {
+		u32 mode = a3_read_field(p, a3_mode_addr[i], a3_mode_bit[i], a3_mode_w[i]);
+		u32 dir = a3_read_field(p, a3_dir_addr[i], a3_dir_bit[i], a3_dir_w[i]);
+		u32 ies = a3_read_field(p, a3_ies_addr[i], a3_ies_bit[i], a3_ies_w[i]);
+		u32 din = a3_read_field(p, a3_datain_addr[i], a3_datain_bit[i], a3_datain_w[i]);
+
+		if (mode || !dir)
+			seq_printf(s, "%3d  %u   %u   %u  %u  %u\n", i, mode, dir, ies, din, din);
+	}
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(a3_mux);
+
+static ssize_t a3_set_write(struct file *f, const char __user *ubuf,
+			    size_t len, loff_t *ppos)
+{
+	struct a3_pin *p = f->private_data;
+	char buf[64];
+	unsigned int pin, mode;
+
+	if (len >= sizeof(buf))
+		return -EINVAL;
+	if (copy_from_user(buf, ubuf, len))
+		return -EFAULT;
+	buf[len] = 0;
+	if (sscanf(buf, "%u %u", &pin, &mode) != 2 || pin >= A3_NPINS || mode > 7)
+		return -EINVAL;
+
+	a3_rmw(p, a3_mode_addr[pin], a3_mode_bit[pin], a3_mode_w[pin], mode);
+	dev_info(p->dev, "pin %u mode -> %u\n", pin, mode);
+	return len;
+}
+static int a3_set_open(struct inode *inode, struct file *file)
+{
+	file->private_data = inode->i_private;
+	return 0;
+}
+
+static const struct file_operations a3_set_fops = {
+	.owner = THIS_MODULE,
+	.open = a3_set_open,
+	.write = a3_set_write,
+};
+
+static int a3_pin_probe(struct platform_device *pdev)
+{
+	struct a3_pin *p;
+	int ret;
+
+	p = devm_kzalloc(&pdev->dev, sizeof(*p), GFP_KERNEL);
+	if (!p)
+		return -ENOMEM;
+	p->dev = &pdev->dev;
+	p->base = devm_ioremap(&pdev->dev, A3_GPIO_BASE, A3_GPIO_SIZE);
+	if (!p->base)
+		return -ENOMEM;
+
+	p->gc.label = "a3-gpio";
+	p->gc.parent = &pdev->dev;
+	p->gc.owner = THIS_MODULE;
+	p->gc.base = -1;
+	p->gc.ngpio = A3_NGPIOS;
+	p->gc.can_sleep = false;
+	p->gc.get_direction = a3_gpio_get_direction;
+	p->gc.direction_input = a3_gpio_direction_input;
+	p->gc.direction_output = a3_gpio_direction_output;
+	p->gc.get = a3_gpio_get;
+	p->gc.set = a3_gpio_set;
+	p->gc.fwnode = dev_fwnode(&pdev->dev);
+
+	ret = devm_gpiochip_add_data(&pdev->dev, &p->gc, p);
+	if (ret)
+		return dev_err_probe(&pdev->dev, ret, "gpiochip add failed\n");
+
+	platform_set_drvdata(pdev, p);
+	debugfs_create_file("pins", 0444, NULL, p, &a3_mux_fops);
+	debugfs_create_file("setmux", 0200, NULL, p, &a3_set_fops);
+
+	dev_info(&pdev->dev, "A3 pin controller: %d GPIOs (%d with tables) at %#x\n",
+		 A3_NGPIOS, A3_NPINS, A3_GPIO_BASE);
+	return 0;
+}
+
+static const struct of_device_id a3_pin_of_match[] = {
+	{ .compatible = "mediatek,mt6771-pinctrl" },
+	{ .compatible = "oppo,a3-pinctrl" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a3_pin_of_match);
+
+static struct platform_driver a3_pin_driver = {
+	.driver = {
+		.name = "a3-pinctrl",
+		.of_match_table = a3_pin_of_match,
+	},
+	.probe = a3_pin_probe,
+};
+module_platform_driver(a3_pin_driver);
+
+MODULE_DESCRIPTION("OPPO A3 (MT6771) pin controller / GPIO");
+MODULE_LICENSE("GPL");
