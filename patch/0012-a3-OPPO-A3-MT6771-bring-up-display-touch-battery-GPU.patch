diff --git a/drivers/input/touchscreen/a3-nt36672.c b/drivers/input/touchscreen/a3-nt36672.c
new file mode 100644
index 000000000..090b26b04
--- /dev/null
+++ b/drivers/input/touchscreen/a3-nt36672.c
@@ -0,0 +1,723 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * a3-nt36672 - Novatek NT36672A (TDDI) touchscreen for the OPPO A3.
+ *
+ * The display and the touch core share one die.  On this board the hardware
+ * i2c0 controller never sees the chip, while a bit-banged bus on the very same
+ * pads (82/83) works, so the device is instantiated under the i2c-gpio node and
+ * this driver binds to that client.
+ *
+ * Protocol (all from the vendor driver, NT36672A memory map):
+ *   bootloader reset : write {0x00, 0x69} to 0x62
+ *   state            : read EVENT_MAP_RESET_COMPLETE (0x60) at 0x01,
+ *                      valid values are 0xA0..0xAF
+ *   event buffer     : 0x21C00, reached by writing {0xFF, 0x02, 0x1C} to 0x01
+ *   touch points     : 65 bytes at offset 0, 6 bytes per point starting at 1
+ *                        state = b[0] & 0x07        (1 = down, 2 = move)
+ *                        x     = (b[1] << 4) | (b[3] >> 4)
+ *                        y     = (b[2] << 4) | (b[3] & 0x0F)
+ *                        w     = b[4]
+ *                        p     = b[5] (+ high byte for the first two slots)
+ *
+ * There is no usable interrupt line in our device tree, so points are polled.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/input.h>
+#include <linux/input/mt.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/workqueue.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
+
+#define NT_HW_ADDR		0x62
+#define NT_FW_ADDR		0x01
+
+#define NT_EVENT_RESET_COMPLETE	0x60
+#define NT_STATE_INIT		0xa0
+#define NT_STATE_MAX		0xaf
+
+#define NT_EVENT_BUF_ADDR	0x21c00
+#define NT_POINT_DATA_LEN	61	/* full record area, like the vendor */
+#define NT_MAX_POINTS		10
+
+/*
+ * Phantom points have shown contact widths of 1 and 3, while real fingers
+ * report 5 and up.  Both values are runtime tunable so they can be adjusted
+ * without reflashing.
+ */
+static int a3_ghost_min_w = 5;
+module_param(a3_ghost_min_w, int, 0644);
+MODULE_PARM_DESC(a3_ghost_min_w, "minimum contact width accepted as a finger");
+
+static int a3_press_frames = 3;
+module_param(a3_press_frames, int, 0644);
+MODULE_PARM_DESC(a3_press_frames, "consecutive frames required before a press");
+#define A3_DEDUP_PX	60	/* records closer than this are the same finger */
+#define A3_MAX_JUMP	400	/* larger single-frame moves are treated as spikes */
+#define NT_X_MAX		1079
+#define NT_Y_MAX		2279
+
+#define PIN_BASE		0x10005000
+#define RST_MODE_OFF		0x350
+#define RST_MODE_BIT		8
+#define RST_MODE_W		3
+#define RST_DIR_OFF		0x010
+#define RST_DIR_BIT		10
+#define BB_MODE_OFF	0x3a0	/* pins 82/83 */
+#define BB_MODE_BIT	8		/* 82 at bit 8, 83 at bit 12 */
+#define BB_MODE_W	3
+#define BB_DIR_OFF	0x020
+#define BB_DIR_SDA	18
+#define BB_DIR_SCL	19
+#define BB_DOUT_OFF	0x120
+#define BB_DOUT_SDA	18
+#define BB_DOUT_SCL	19
+#define BB_DIN_OFF	0x220
+#define BB_DIN_SDA	18
+#define BB_DELAY_US	1
+#define IRQ_MODE_OFF	0x300	/* 0x100 -> GPIO 1 */
+#define IRQ_MODE_BIT	4
+#define IRQ_MODE_W	3
+#define IRQ_DIR_OFF	0x000
+#define IRQ_DIR_BIT	1
+#define IRQ_IES_OFF	0x000
+#define IRQ_IES_BIT	3
+#define IRQ_DIN_OFF	0x200
+#define IRQ_DIN_BIT	1
+#define NT_FORCE_READ_MS	100
+#define RST_DOUT_OFF		0x110
+#define RST_DOUT_BIT		10
+
+#define NT_POLL_MS		16
+
+struct a3_nt {
+	struct i2c_client *client;
+	struct input_dev *input;
+	struct delayed_work poll;
+	bool running;
+	int errors;
+	bool page_set;
+	unsigned long last_reinit;
+	int last_x[10];
+	int last_y[10];
+	bool last_down[10];
+	int seen[10];
+};
+
+static void __iomem *pinctrl;
+static unsigned long a3_nt_last_force;
+
+/* the touch interrupt line is active low */
+static bool nt_irq_active(void)
+{
+	u32 v;
+
+	if (!pinctrl)
+		return true;		/* no pin access: never skip a read */
+	return !(readl(pinctrl + IRQ_DIN_OFF) & (1 << IRQ_DIN_BIT));
+}
+
+static void bb_mode(u32 off, u32 bit, u32 val)
+{
+	u32 v = readl(pinctrl + off);
+
+	v &= ~(((1 << BB_MODE_W) - 1) << bit);
+	writel(v | ((val & ((1 << BB_MODE_W) - 1)) << bit), pinctrl + off);
+}
+
+#define bb_sda_low()  do { u32 v = readl(pinctrl + BB_DOUT_OFF); \
+		writel(v & ~(1 << BB_DOUT_SDA), pinctrl + BB_DOUT_OFF); \
+		v = readl(pinctrl + BB_DIR_OFF); \
+		writel(v & ~(1 << BB_DIR_SDA), pinctrl + BB_DIR_OFF); } while (0)
+#define bb_sda_rel()  do { u32 v = readl(pinctrl + BB_DIR_OFF); \
+		writel(v | (1 << BB_DIR_SDA), pinctrl + BB_DIR_OFF); } while (0)
+#define bb_scl_low()  do { u32 v = readl(pinctrl + BB_DOUT_OFF); \
+		writel(v & ~(1 << BB_DOUT_SCL), pinctrl + BB_DOUT_OFF); \
+		v = readl(pinctrl + BB_DIR_OFF); \
+		writel(v & ~(1 << BB_DIR_SCL), pinctrl + BB_DIR_OFF); } while (0)
+#define bb_scl_rel()  do { u32 v = readl(pinctrl + BB_DIR_OFF); \
+		writel(v | (1 << BB_DIR_SCL), pinctrl + BB_DIR_OFF); } while (0)
+#define bb_sda_val()  (!!(readl(pinctrl + BB_DIN_OFF) & (1 << BB_DIN_SDA)))
+
+static void bb_setup(void)
+{
+	u32 v;
+
+	bb_mode(BB_MODE_OFF, BB_MODE_BIT, 0);
+	bb_mode(BB_MODE_OFF, BB_MODE_BIT + 4, 0);
+	/*
+	 * Input enable so DIN reflects the pad.  Pins 82/83 share IES bit 7 in
+	 * the 0x000 register (from the generated pin table); using per-pin bit
+	 * numbers here makes the reads return 0 forever.
+	 */
+	v = readl(pinctrl + 0x000);
+	writel(v | (1 << 7), pinctrl + 0x000);
+	bb_sda_rel();
+	bb_scl_rel();
+}
+
+static void bb_start(void)
+{
+	bb_sda_rel(); bb_scl_rel();
+	bb_sda_low(); udelay(BB_DELAY_US);
+	bb_scl_low(); udelay(BB_DELAY_US);
+}
+
+static void bb_stop(void)
+{
+	bb_scl_low(); bb_sda_low(); udelay(BB_DELAY_US);
+	bb_scl_rel(); udelay(BB_DELAY_US);
+	bb_sda_rel(); udelay(BB_DELAY_US);
+}
+
+static int bb_write_byte(u8 b)
+{
+	int i, ack;
+
+	for (i = 7; i >= 0; i--) {
+		if (b & (1 << i))
+			bb_sda_rel();
+		else
+			bb_sda_low();
+		udelay(BB_DELAY_US);
+		bb_scl_rel(); udelay(BB_DELAY_US);
+		bb_scl_low(); udelay(BB_DELAY_US);
+	}
+	bb_sda_rel(); udelay(BB_DELAY_US);
+	bb_scl_rel(); udelay(BB_DELAY_US);
+	ack = !bb_sda_val();
+	bb_scl_low(); udelay(BB_DELAY_US);
+	return ack;
+}
+
+static u8 bb_read_byte(bool ack)
+{
+	u8 b = 0;
+	int i;
+
+	bb_sda_rel();
+	for (i = 7; i >= 0; i--) {
+		udelay(BB_DELAY_US);
+		bb_scl_rel(); udelay(BB_DELAY_US);
+		if (bb_sda_val())
+			b |= (1 << i);
+		bb_scl_low(); udelay(BB_DELAY_US);
+	}
+	if (ack)
+		bb_sda_low();
+	else
+		bb_sda_rel();
+	udelay(BB_DELAY_US);
+	bb_scl_rel(); udelay(BB_DELAY_US);
+	bb_scl_low(); udelay(BB_DELAY_US);
+	bb_sda_rel();
+	return b;
+}
+
+/* write one register byte then read len bytes, all by hand */
+static int a3_bb_read_reg(u8 addr, u8 reg, u8 *out, int len)
+{
+	int i;
+
+	if (!pinctrl)
+		return -ENODEV;
+
+	bb_start();
+	if (!bb_write_byte(addr << 1)) {
+		bb_stop();
+		return -EIO;
+	}
+	if (!bb_write_byte(reg)) {
+		bb_stop();
+		return -EIO;
+	}
+
+	bb_start();
+	if (!bb_write_byte((addr << 1) | 1)) {
+		bb_stop();
+		return -EIO;
+	}
+	for (i = 0; i < len; i++)
+		out[i] = bb_read_byte(i < len - 1);
+	bb_stop();
+	return 0;
+}
+
+static int a3_bb_write_bytes(u8 addr, const u8 *data, int len)
+{
+	int i;
+
+	if (!pinctrl)
+		return -ENODEV;
+
+	bb_start();
+	if (!bb_write_byte(addr << 1)) {
+		bb_stop();
+		return -EIO;
+	}
+	for (i = 0; i < len; i++) {
+		if (!bb_write_byte(data[i]))
+			break;
+	}
+	bb_stop();
+	return 0;
+}
+
+static int a3_bb_set_page(u32 addr)
+{
+	u8 p[3] = { 0xff, (addr >> 16) & 0xff, (addr >> 8) & 0xff };
+
+	return a3_bb_write_bytes(NT_FW_ADDR, p, sizeof(p));
+}
+
+static void nt_irq_pin_setup(void)
+{
+	u32 v;
+
+	if (!pinctrl)
+		return;
+	/* GPIO function, input, input-enable so DIN reflects the pad */
+	v = readl(pinctrl + IRQ_MODE_OFF);
+	v &= ~(((1 << IRQ_MODE_W) - 1) << IRQ_MODE_BIT);
+	writel(v, pinctrl + IRQ_MODE_OFF);
+
+	v = readl(pinctrl + IRQ_DIR_OFF);
+	v |= (1 << IRQ_DIR_BIT);
+	writel(v, pinctrl + IRQ_DIR_OFF);
+
+	v = readl(pinctrl + IRQ_IES_OFF);
+	v |= (1 << IRQ_IES_BIT);
+	writel(v, pinctrl + IRQ_IES_OFF);
+}
+/* 0 = do not poll; inspect the raw frame through debugfs first */
+static int a3_nt_poll_ms = 6;
+module_param(a3_nt_poll_ms, int, 0644);
+MODULE_PARM_DESC(a3_nt_poll_ms, "touch poll interval in ms, 0 disables polling");
+static struct a3_nt *a3_nt_ctx;
+/* registering an input device turns a bad frame into an event storm; keep it
+ * opt-in until the raw frames have been checked through debugfs */
+static bool a3_nt_input = true;
+module_param(a3_nt_input, bool, 0644);
+MODULE_PARM_DESC(a3_nt_input, "register the input device");
+
+static void nt_reset_pulse(void)
+{
+	u32 v;
+
+	if (!pinctrl)
+		return;
+
+	v = readl(pinctrl + RST_MODE_OFF);
+	v &= ~(((1 << RST_MODE_W) - 1) << RST_MODE_BIT);
+	writel(v, pinctrl + RST_MODE_OFF);
+
+	v = readl(pinctrl + RST_DIR_OFF);
+	v &= ~(1 << RST_DIR_BIT);
+	writel(v, pinctrl + RST_DIR_OFF);
+
+	v = readl(pinctrl + RST_DOUT_OFF);
+	writel(v | (1 << RST_DOUT_BIT), pinctrl + RST_DOUT_OFF);
+	msleep(20);
+	writel(v & ~(1 << RST_DOUT_BIT), pinctrl + RST_DOUT_OFF);
+	msleep(20);
+	writel(v | (1 << RST_DOUT_BIT), pinctrl + RST_DOUT_OFF);
+	msleep(120);
+}
+
+static int nt_write_buf(struct i2c_client *c, u8 addr, const u8 *buf, int len)
+{
+	struct i2c_msg msg = { .addr = addr, .flags = 0, .len = len,
+			       .buf = (u8 *)buf };
+
+	return i2c_transfer(c->adapter, &msg, 1) == 1 ? 0 : -EIO;
+}
+
+/* write one register byte, then read len bytes back */
+static int nt_read_buf(struct i2c_client *c, u8 addr, u8 reg, u8 *out, int len)
+{
+	struct i2c_msg msg[2] = {
+		{ .addr = addr, .flags = 0, .len = 1, .buf = &reg },
+		{ .addr = addr, .flags = I2C_M_RD, .len = len, .buf = out },
+	};
+
+	return i2c_transfer(c->adapter, msg, 2) == 2 ? 0 : -EIO;
+}
+
+static int nt_set_page(struct i2c_client *c, u32 page_addr)
+{
+	u8 p[3] = { 0xff, (page_addr >> 16) & 0xff, (page_addr >> 8) & 0xff };
+
+	return nt_write_buf(c, NT_FW_ADDR, p, sizeof(p));
+}
+
+static int nt_wait_ready(struct i2c_client *c)
+{
+	u8 buf[6];
+	int i;
+
+	for (i = 0; i < 100; i++) {
+		if (!nt_read_buf(c, NT_FW_ADDR, NT_EVENT_RESET_COMPLETE, buf, 6) &&
+		    buf[0] >= NT_STATE_INIT && buf[0] <= NT_STATE_MAX)
+			return 0;
+		msleep(10);
+	}
+	return -ETIMEDOUT;
+}
+
+static int nt_reinit(struct a3_nt *nt)
+{
+	struct i2c_client *c = nt->client;
+	int ret;
+
+	dev_warn(&c->dev, "touch lost, re-initialising\n");
+
+	nt_reset_pulse();
+	nt_write_buf(c, NT_HW_ADDR, (u8[]){ 0x00, 0x69 }, 2);
+	msleep(35);
+
+	ret = nt_wait_ready(c);
+	if (ret == 0)
+		ret = nt_set_page(c, NT_EVENT_BUF_ADDR);
+
+	if (ret)
+		dev_warn(&c->dev, "re-init failed: %d\n", ret);
+	else
+		dev_info(&c->dev, "touch back online\n");
+
+	nt->page_set = false;
+	memset(nt->last_down, 0, sizeof(nt->last_down));
+	return ret;
+}
+
+static void nt_report(struct a3_nt *nt)
+{
+	struct i2c_client *c = nt->client;
+	struct input_dev *idev = nt->input;
+	u8 buf[NT_POINT_DATA_LEN + 1];
+	int i, reported = 0;
+	static bool logged_first;
+
+	/* the page register keeps its value, no need to rewrite it every poll */
+	if (!nt->page_set) {
+		if (nt_set_page(c, NT_EVENT_BUF_ADDR))
+			goto lost;
+		nt->page_set = true;
+	}
+
+	if (nt_read_buf(c, NT_FW_ADDR, 0x00, &buf[1], NT_POINT_DATA_LEN)) {
+lost:
+		nt->page_set = false;
+		/*
+		 * Never stop polling: one glitch used to disable touch until the
+		 * next reboot.  Re-initialise only after about a second of
+		 * continuous failure and at most every 5 s; resetting a healthy
+		 * chip made the pointer jump.
+		 */
+		if (++nt->errors >= 150 &&
+		    time_after(jiffies, nt->last_reinit + msecs_to_jiffies(5000))) {
+			nt->last_reinit = jiffies;
+			nt->errors = 0;
+			nt_reinit(nt);
+		}
+		return;
+	}
+	nt->errors = 0;
+
+	/*
+	 * Slot index comes from the chip: vendor parses the same 6-byte record
+	 * and uses pointid = (b[0] >> 3) - 1 as the finger number.  Using the
+	 * loop counter instead would scatter a single finger across slots.
+	 */
+	for (i = 0; i < NT_MAX_POINTS; i++)
+		input_mt_slot(idev, i);
+	{
+		int rep_x[NT_MAX_POINTS], rep_y[NT_MAX_POINTS];
+		bool rep_slot[NT_MAX_POINTS] = { false };
+		int nrep = 0;
+
+		for (i = 0; i < NT_MAX_POINTS; i++)
+			input_mt_slot(idev, i);
+
+		/* only the records actually read: buf is NT_POINT_DATA_LEN+1 bytes */
+		for (i = 0; i < NT_POINT_DATA_LEN / 6; i++) {
+			int pos = 1 + 6 * i;
+			u8 state = buf[pos] & 0x07;
+			int pid = (buf[pos] >> 3) - 1;
+			unsigned int x, y;
+			bool down = (state == 0x01 || state == 0x02);
+			int k, dup = 0;
+
+			if (!down || pid < 0 || pid >= NT_MAX_POINTS)
+				continue;
+
+			x = (buf[pos + 1] << 4) | (buf[pos + 3] >> 4);
+			y = (buf[pos + 2] << 4) | (buf[pos + 3] & 0x0f);
+			if (x > NT_X_MAX || y > NT_Y_MAX)
+				continue;
+
+			/*
+			 * The panel occasionally emits a phantom record with a
+			 * one-pixel contact width at a fixed spot; real fingers
+			 * report 5 and up.  Also require the slot to be seen
+			 * twice before it turns into a press.
+			 */
+			if (buf[pos + 4] < a3_ghost_min_w) {
+				nt->seen[pid] = 0;
+				continue;
+			}
+			if (!nt->last_down[pid] && ++nt->seen[pid] < a3_press_frames)
+				continue;
+
+			/* the chip repeats/ghosts records: merge near-identical ones */
+			for (k = 0; k < nrep; k++) {
+				int dx = (int)x - rep_x[k], dy = (int)y - rep_y[k];
+
+				if (abs(dx) < A3_DEDUP_PX && abs(dy) < A3_DEDUP_PX) {
+					dup = 1;
+					break;
+				}
+			}
+			if (dup)
+				continue;
+
+			/* single-frame teleports are spikes, keep the previous value */
+			if (nt->last_down[pid]) {
+				int dx = (int)x - nt->last_x[pid];
+				int dy = (int)y - nt->last_y[pid];
+
+				if (abs(dx) > A3_MAX_JUMP || abs(dy) > A3_MAX_JUMP) {
+					x = nt->last_x[pid];
+					y = nt->last_y[pid];
+				}
+			}
+
+			rep_x[nrep] = x;
+			rep_y[nrep] = y;
+			nrep++;
+			rep_slot[pid] = true;
+
+			nt->last_x[pid] = x;
+			nt->last_y[pid] = y;
+			nt->last_down[pid] = true;
+
+			input_mt_slot(idev, pid);
+			input_mt_report_slot_state(idev, MT_TOOL_FINGER, true);
+			input_report_abs(idev, ABS_MT_POSITION_X, x);
+			input_report_abs(idev, ABS_MT_POSITION_Y, y);
+			input_report_abs(idev, ABS_MT_TOUCH_MAJOR, buf[pos + 4] ?: 1);
+			input_report_abs(idev, ABS_MT_PRESSURE, buf[pos + 5] ?: 1);
+			reported++;
+		}
+
+		/*
+	 * Release slots that were down last frame but are not reported now.
+	 * This must compare against per-slot flags: nrep is a count, comparing
+	 * a slot number against it released the finger in the same frame it was
+	 * pressed, which made the touch look completely dead.
+	 */
+		for (i = 0; i < NT_MAX_POINTS; i++) {
+			if (rep_slot[i] || !nt->last_down[i])
+				continue;
+			nt->last_down[i] = false;
+			input_mt_slot(idev, i);
+			input_mt_report_slot_state(idev, MT_TOOL_FINGER, false);
+		}
+	}
+
+	input_mt_sync_frame(idev);
+	input_sync(idev);
+
+	if (reported && !logged_first) {
+		logged_first = true;
+		dev_info(&c->dev, "first frame: %*ph\n", 12, &buf[1]);
+		dev_info(&c->dev, "touch points detected, input is live\n");
+	}
+}
+
+static void nt_poll_work(struct work_struct *w)
+{
+	struct a3_nt *nt = container_of(to_delayed_work(w), struct a3_nt, poll);
+
+	nt_report(nt);
+	if (a3_nt_poll_ms > 0)
+		schedule_delayed_work(&nt->poll, msecs_to_jiffies(a3_nt_poll_ms));
+}
+
+static int a3_nt_dump_show(struct seq_file *s, void *unused)
+{
+	u8 buf[NT_POINT_DATA_LEN + 1] = {0};
+	int i;
+
+	if (!a3_nt_ctx)
+		return -ENODEV;
+	if (nt_set_page(a3_nt_ctx->client, NT_EVENT_BUF_ADDR))
+		return -EIO;
+	if (nt_read_buf(a3_nt_ctx->client, NT_FW_ADDR, 0x00, &buf[1],
+			NT_POINT_DATA_LEN))
+		return -EIO;
+
+	seq_printf(s, "raw:");
+	for (i = 1; i <= NT_POINT_DATA_LEN; i++)
+		seq_printf(s, " %02x", buf[i]);
+	seq_putc(s, '\n');
+
+	for (i = 0; i < NT_MAX_POINTS; i++) {
+		int p = 1 + 6 * i;
+		seq_printf(s, "slot %d: state=%u x=%u y=%u w=%u p=%u\n", i,
+			   buf[p] & 0x07,
+			   (buf[p + 1] << 4) | (buf[p + 3] >> 4),
+			   (buf[p + 2] << 4) | (buf[p + 3] & 0x0f),
+			   buf[p + 4], buf[p + 5]);
+	}
+	return 0;
+}
+
+static int a3_nt_dump_open(struct inode *i, struct file *f)
+{
+	return single_open(f, a3_nt_dump_show, NULL);
+}
+
+static const struct file_operations a3_nt_dump_fops = {
+	.owner = THIS_MODULE,
+	.open = a3_nt_dump_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static int a3_nt_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct a3_nt *nt;
+	struct input_dev *idev;
+	int ret;
+
+	nt = devm_kzalloc(dev, sizeof(*nt), GFP_KERNEL);
+	if (!nt)
+		return -ENOMEM;
+	nt->client = client;
+	i2c_set_clientdata(client, nt);
+	a3_nt_ctx = nt;
+
+	dev_info(dev, "bound on %s at 0x%02x\n",
+		 client->adapter->name, client->addr);
+
+	nt_reset_pulse();
+	nt_irq_pin_setup();
+
+	ret = nt_write_buf(client, NT_HW_ADDR, (u8[]){ 0x00, 0x69 }, 2);
+	if (ret)
+		dev_warn(dev, "bootloader reset failed: %d\n", ret);
+	msleep(35);
+
+	ret = nt_wait_ready(client);
+	if (ret) {
+		dev_warn(dev, "touch did not reach a valid reset state\n");
+		return 0;
+	}
+	dev_info(dev, "touch ready (reset-complete state ok)\n");
+	/*
+	 * From here on the driver talks to the chip with its own bit-banged
+	 * bus: the gpiod based i2c-gpio path costs ~2.3 ms per 13-byte read,
+	 * which is what made the pointer feel laggy.
+	 */
+
+	if (!a3_nt_input) {
+		dev_info(dev, "input registration disabled; read %s to inspect frames\n",
+			 "debugfs/nt36672_dump");
+		return 0;
+	}
+
+	idev = devm_input_allocate_device(dev);
+	if (!idev)
+		return -ENOMEM;
+	nt->input = idev;
+
+	idev->name = "a3-nt36672-touch";
+	idev->id.bustype = BUS_I2C;
+	idev->dev.parent = dev;
+
+	input_set_abs_params(idev, ABS_MT_POSITION_X, 0, NT_X_MAX, 0, 0);
+	input_set_abs_params(idev, ABS_MT_POSITION_Y, 0, NT_Y_MAX, 0, 0);
+	input_set_abs_params(idev, ABS_MT_TOUCH_MAJOR, 0, 255, 0, 0);
+	input_set_abs_params(idev, ABS_MT_PRESSURE, 0, 1000, 0, 0);
+	input_set_abs_params(idev, ABS_MT_SLOT, 0, NT_MAX_POINTS - 1, 0, 0);
+	input_set_abs_params(idev, ABS_MT_TRACKING_ID, 0, 65535, 0, 0);
+
+	ret = input_mt_init_slots(idev, NT_MAX_POINTS, INPUT_MT_DIRECT);
+	if (ret) {
+		dev_err(dev, "input_mt_init_slots: %d\n", ret);
+		return ret;
+	}
+
+	ret = input_register_device(idev);
+	if (ret) {
+		dev_err(dev, "input_register_device: %d\n", ret);
+		return ret;
+	}
+
+	INIT_DELAYED_WORK(&nt->poll, nt_poll_work);
+	if (a3_nt_poll_ms > 0) {
+		schedule_delayed_work(&nt->poll, msecs_to_jiffies(200));
+		dev_info(dev, "polling every %d ms\n", a3_nt_poll_ms);
+	} else {
+		dev_info(dev, "polling disabled (a3_nt36672.a3_nt_poll_ms=N to enable)\n");
+	}
+	dev_info(dev, "input device registered (%dx%d)\n",
+		 NT_X_MAX + 1, NT_Y_MAX + 1);
+	return 0;
+}
+
+static void a3_nt_remove(struct i2c_client *client)
+{
+	struct a3_nt *nt = i2c_get_clientdata(client);
+
+	cancel_delayed_work_sync(&nt->poll);
+}
+
+static const struct i2c_device_id a3_nt_id[] = {
+	{ "nova-nt36672", 0 },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, a3_nt_id);
+
+static const struct of_device_id a3_nt_of_match[] = {
+	{ .compatible = "nova-nt36672" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, a3_nt_of_match);
+
+static struct i2c_driver a3_nt_driver = {
+	.driver = {
+		.name = "nova-nt36672",
+		.of_match_table = a3_nt_of_match,
+	},
+	.probe = a3_nt_probe,
+	.remove = a3_nt_remove,
+	.id_table = a3_nt_id,
+};
+
+static int __init a3_nt_init(void)
+{
+	pinctrl = ioremap(PIN_BASE, 0x1000);
+	if (!pinctrl)
+		pr_warn("a3-nt: cannot map pin controller\n");
+	debugfs_create_file("nt36672_dump", 0444, NULL, NULL, &a3_nt_dump_fops);
+	return i2c_add_driver(&a3_nt_driver);
+}
+
+static void __exit a3_nt_exit(void)
+{
+	i2c_del_driver(&a3_nt_driver);
+	if (pinctrl)
+		iounmap(pinctrl);
+}
+
+module_init(a3_nt_init);
+module_exit(a3_nt_exit);
+
+MODULE_DESCRIPTION("OPPO A3 NT36672A touchscreen");
+MODULE_LICENSE("GPL");
diff --git a/drivers/input/touchscreen/a3-touch-timeline.c b/drivers/input/touchscreen/a3-touch-timeline.c
new file mode 100644
index 000000000..52e36a2dd
--- /dev/null
+++ b/drivers/input/touchscreen/a3-touch-timeline.c
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * a3-touch-timeline - find out *when* the Novatek touch stops answering.
+ *
+ * Every attempt so far was made after boot, when the DSI panel had already
+ * been taken over and reset by mtk_dsi.  If the touch core answers early and
+ * goes away once the panel is initialised, a single late probe can never see
+ * it.  This driver samples i2c0 in a tight loop from early boot and logs the
+ * transition, which turns "it never answers" into a timestamped fact.
+ */
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/workqueue.h>
+
+#define A3_BUS		0
+#define A3_POLL_MS	200
+#define A3_POLL_CNT	75	/* 75 * 200 ms = 15 s */
+
+struct a3_tl {
+	struct delayed_work work;
+	int count;
+	struct i2c_adapter *adap;
+};
+
+static void a3_tl_work(struct work_struct *w)
+{
+	struct a3_tl *tl = container_of(to_delayed_work(w), struct a3_tl, work);
+	u8 addr = 0x62;
+	char buf[2] = { 0x00, 0x69 };	/* vendor nvt_bootloader_reset */
+	u8 rb[1];
+	struct i2c_msg msg[2];
+	int ret;
+
+	tl->adap = i2c_get_adapter(A3_BUS);
+	if (!tl->adap) {
+		pr_info("a3-tl: no adapter for bus %d\n", A3_BUS);
+		return;
+	}
+
+	/* try the vendor's reset command: this is what Android sends first */
+	msg[0].addr = addr;
+	msg[0].flags = 0;
+	msg[0].len = sizeof(buf);
+	msg[0].buf = buf;
+
+	ret = i2c_transfer(tl->adap, msg, 1);
+
+	/* also try a plain read so a write-only quirk shows up */
+	msg[0].addr = addr;
+	msg[0].flags = 0;
+	msg[0].len = 1;
+	msg[0].buf = buf;
+	msg[1].addr = addr;
+	msg[1].flags = I2C_M_RD;
+	msg[1].len = 1;
+	msg[1].buf = rb;
+	{
+		int r2 = i2c_transfer(tl->adap, msg, 2);
+
+		if (ret >= 1 || r2 == 2)
+			pr_info("a3-tl[%d]: 0x%02x ALIVE (wr=%d rd=%d)\n",
+				tl->count, addr, ret, r2);
+		else if (tl->count % 10 == 0)
+			pr_info("a3-tl[%d]: 0x%02x silent (wr=%d rd=%d)\n",
+				tl->count, addr, ret, r2);
+	}
+
+	i2c_put_adapter(tl->adap);
+	tl->adap = NULL;
+
+	if (++tl->count < A3_POLL_CNT)
+		schedule_delayed_work(&tl->work, msecs_to_jiffies(A3_POLL_MS));
+	else
+		pr_info("a3-tl: done\n");
+}
+
+static struct a3_tl *a3_tl_ctx;
+
+static int __init a3_tl_init(void)
+{
+	a3_tl_ctx = kzalloc(sizeof(*a3_tl_ctx), GFP_KERNEL);
+	if (!a3_tl_ctx)
+		return -ENOMEM;
+
+	INIT_DELAYED_WORK(&a3_tl_ctx->work, a3_tl_work);
+	schedule_delayed_work(&a3_tl_ctx->work, msecs_to_jiffies(300));
+	pr_info("a3-tl: sampling i2c%d for 0x62\n", A3_BUS);
+	return 0;
+}
+
+static void __exit a3_tl_exit(void)
+{
+	if (a3_tl_ctx) {
+		cancel_delayed_work_sync(&a3_tl_ctx->work);
+		kfree(a3_tl_ctx);
+	}
+}
+
+module_init(a3_tl_init);
+module_exit(a3_tl_exit);
+
+MODULE_DESCRIPTION("OPPO A3 touch presence timeline probe");
+MODULE_LICENSE("GPL");
