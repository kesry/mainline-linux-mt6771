From 85a348f24ff79c5b0ac4d947cb45e6e4bbb81463 Mon Sep 17 00:00:00 2001
From: oppoa3-port <port@oppoa3.local>
Date: Wed, 4 Nov 2026 00:38:26 +0800
Subject: [PATCH 03/12] arm64: a3: add initcall-level framebuffer paint for
 silent-boot diagnosis

The board has no UART test point and no USB support yet, so a kernel that
dies before fbcon comes up leaves no evidence at all: the panel keeps showing
LK's stale framebuffer and the watchdog resets the board 30 s later.

CONFIG_A3_EARLY_PAINT paints a band of the framebuffer a different colour at
each initcall level. The colour left on screen after a reset identifies the
last level reached. Temporary; remove once a console exists.

Also enable the debug UART (921600n8, as the vendor kernel uses) so a serial
console exists the moment one is physically attached.
---
 arch/arm64/Kconfig                       | 17 +++++++
 arch/arm64/boot/dts/mediatek/mt6771.dtsi |  4 +-
 arch/arm64/kernel/Makefile               |  2 +
 arch/arm64/kernel/a3-early-paint.c       | 65 ++++++++++++++++++++++++
 4 files changed, 85 insertions(+), 3 deletions(-)
 create mode 100644 arch/arm64/kernel/a3-early-paint.c

diff --git a/arch/arm64/Kconfig b/arch/arm64/Kconfig
index 7ae3cd7cc..9328b4d0c 100644
--- a/arch/arm64/Kconfig
+++ b/arch/arm64/Kconfig
@@ -2540,3 +2540,20 @@ source "drivers/acpi/Kconfig"
 
 source "arch/arm64/kvm/Kconfig"
 
+menu "OPPO A3 (MT6771) bring-up hacks"
+
+config A3_EARLY_PAINT
+	bool "Paint the framebuffer at each initcall level"
+	depends on ARCH_MEDIATEK
+	help
+	  TEMPORARY bring-up aid for the OPPO A3 (MT6771) mainline port.
+
+	  The board has no UART test point and mainline has no USB support for
+	  it yet, so a kernel that dies before fbcon comes up leaves no trace at
+	  all. With this enabled the kernel paints a band of the framebuffer a
+	  different colour at every initcall level; the colour left on screen
+	  after a reset identifies the last level reached.
+
+	  Say N for anything but bring-up.
+
+endmenu
diff --git a/arch/arm64/boot/dts/mediatek/mt6771.dtsi b/arch/arm64/boot/dts/mediatek/mt6771.dtsi
index 02cf37ecd..68f3cb0a1 100644
--- a/arch/arm64/boot/dts/mediatek/mt6771.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt6771.dtsi
@@ -143,9 +143,7 @@ uart0: serial@11002000 {
 		interrupts = <GIC_SPI 91 IRQ_TYPE_LEVEL_HIGH>;
 		clocks = <&clk26m>, <&clk26m>;
 		clock-names = "baud", "bus";
-		/* No UART test point on this board: keep the node for later, */
-		/* but do not let a possibly-wrong IRQ stall the first boot.  */
-		status = "disabled";
+		status = "okay";
 	};
 
 	/*
diff --git a/arch/arm64/kernel/Makefile b/arch/arm64/kernel/Makefile
index 37fa16b43..ed4e4a40c 100644
--- a/arch/arm64/kernel/Makefile
+++ b/arch/arm64/kernel/Makefile
@@ -86,5 +86,7 @@ ifeq ($(CONFIG_DEBUG_EFI),y)
 AFLAGS_head.o += -DVMLINUX_PATH="\"$(realpath $(objtree)/vmlinux)\""
 endif
 
+obj-$(CONFIG_A3_EARLY_PAINT) += a3-early-paint.o
+
 # for cleaning
 subdir- += vdso vdso32
diff --git a/arch/arm64/kernel/a3-early-paint.c b/arch/arm64/kernel/a3-early-paint.c
new file mode 100644
index 000000000..fd8d39675
--- /dev/null
+++ b/arch/arm64/kernel/a3-early-paint.c
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * TEMPORARY bring-up aid for the OPPO A3 (MT6771) mainline port.
+ *
+ * Problem: this board has no UART test point and no USB support in the
+ * mainline tree yet, so a kernel that dies before fbcon comes up leaves
+ * absolutely no trace -- the panel just keeps showing whatever LK left in
+ * the framebuffer, and the watchdog resets the board ~30 s later.
+ *
+ * Trick (from the porting notes, section 5.3): paint a band of the
+ * framebuffer a different colour at each initcall level. Whatever colour is
+ * still on the screen when the board resets tells us the last level reached:
+ *
+ *   stale LK image  -> never got to early_initcall
+ *   RED             -> early_initcall, died before core_initcall
+ *   GREEN           -> core_initcall, died before postcore_initcall
+ *   BLUE            -> postcore_initcall
+ *   YELLOW          -> arch_initcall
+ *   MAGENTA         -> subsys_initcall
+ *   CYAN            -> fs_initcall
+ *   WHITE           -> device_initcall (drivers probing, wdt should be stopped)
+ *
+ * Delete this file (and CONFIG_A3_EARLY_PAINT) once a real console exists.
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/kernel.h>
+
+#define A3_FB_BASE	0x7d170000UL
+#define A3_FB_WIDTH	1080
+#define A3_FB_BAND	300		/* rows to paint: enough to be obvious */
+#define A3_FB_STRIDE	4		/* bytes per pixel (32bpp) */
+#define A3_FB_PAINT	(A3_FB_WIDTH * A3_FB_BAND * A3_FB_STRIDE)
+
+static void __init a3_paint(u32 colour)
+{
+	void __iomem *fb;
+	unsigned long i;
+
+	fb = ioremap(A3_FB_BASE, A3_FB_PAINT);
+	if (!fb)
+		return;
+
+	for (i = 0; i < A3_FB_PAINT; i += 4)
+		writel(colour, fb + i);
+
+	iounmap(fb);
+}
+
+static int __init a3_paint_early(void)		{ a3_paint(0x00ff0000); return 0; }
+static int __init a3_paint_core(void)		{ a3_paint(0x0000ff00); return 0; }
+static int __init a3_paint_postcore(void)	{ a3_paint(0x000000ff); return 0; }
+static int __init a3_paint_arch(void)		{ a3_paint(0x00ffff00); return 0; }
+static int __init a3_paint_subsys(void)		{ a3_paint(0x00ff00ff); return 0; }
+static int __init a3_paint_fs(void)		{ a3_paint(0x0000ffff); return 0; }
+static int __init a3_paint_device(void)		{ a3_paint(0x00ffffff); return 0; }
+
+early_initcall(a3_paint_early);
+core_initcall(a3_paint_core);
+postcore_initcall(a3_paint_postcore);
+arch_initcall(a3_paint_arch);
+subsys_initcall(a3_paint_subsys);
+fs_initcall(a3_paint_fs);
+device_initcall(a3_paint_device);
